    '<div class="grid2">'+sel("Paid by","payMethod",METHODS,w.payMethod||"M-PESA")+fld("M-PESA number or account","payAccount","text",w.payAccount)+"</div></fieldset>";
  h+='<fieldset style="margin-top:22px"><legend>Next of kin</legend><div class="grid2">'+fld("Name","ecName","text",w.ecName)+fld("Relationship","ecRel","text",w.ecRel)+"</div>"+fld("Phone","ecPhone","tel",w.ecPhone,{mode:"tel"})+"</fieldset>";
  h+='<fieldset style="margin-top:22px"><legend>Notes</legend><div class="fld"><label for="f_notes" class="sr" style="position:absolute;left:-9999px">Notes</label><textarea class="textarea" id="f_notes" name="notes">'+esc(w.notes)+"</textarea></div></fieldset>";

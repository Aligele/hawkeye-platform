function genPw(){var c="abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789",a=new Uint32Array(10),s="";crypto.getRandomValues(a);for(var i=0;i<a.length;i++)s+=c[a[i]%c.length];return s}

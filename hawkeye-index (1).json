/* ---------- saving ---------- */
function formData(f){var o={},d=new FormData(f);d.forEach(function(v,k){o[k]=String(v).trim()});return o}
function nextNo(){
  var mx=0;S.workers.forEach(function(w){var m=/(\d+)$/.exec(w.workerNo||"");if(m)mx=Math.max(mx,Number(m[1]))});
  return "HW-"+String(mx+1).padStart(4,"0");
}
async function saveWorker(f){
  var o=formData(f);
  if(!isMgr())return;
  if(!o.name){toast("Enter the worker's full name.");document.getElementById("f_name").focus();return}
  var id=f.dataset.id||"";
  if(o.idNo){var dup=S.workers.filter(function(w){return w.idNo===o.idNo&&w.id!==id})[0];if(dup){toast(dup.name+" is already enrolled with this ID number.");return}}
  var old=id?byId(S.workers,id):null;
  var rec=Object.assign({},old||{},o);
  rec.pay=o.pay?Number(o.pay):0;
  var row=wToRow(rec);
  var btn=f.querySelector('[type="submit"]');btn.disabled=true;
  var res=old?await sb.from("hk_workers").update(row).eq("id",id):await sb.from("hk_workers").insert(row).select().single();
  if(res.error){toast(dbErr(res.error));btn.disabled=false;return}
  closeSheet();
  await loadAll();render();
  if(old){toast("Changes saved.");openWorker(id)}else toast(rec.name+" enrolled as "+res.data.worker_no+".");
}
async function saveExpense(f){
  var o=formData(f);
  var amt=Number(o.amount);
  if(!o.date){toast("Choose the date.");return}
  if(!(amt>0)){toast("Enter an amount greater than zero.");document.getElementById("f_amount").focus();return}
  if(!isMgr()&&o.category==="Salary"){toast("Only a manager can record salary payments.");return}
  var id=f.dataset.id||"";
  var old=id?byId(S.allExp,id):null;
  var row={expense_date:o.date,amount:amt,category:o.category,description:nz(o.description),worker_id:nz(o.worker),method:nz(o.method),ref:nz(o.ref)};
  var btn=f.querySelector('[type="submit"]');btn.disabled=true;
  var back=S.sheet&&S.sheet.from;
  var res;
  if(old)res=await sb.from("hk_expenses").update(row).eq("id",id);
  else{row.status=isMgr()?"approved":"pending";res=await sb.from("hk_expenses").insert(row)}
  if(res.error){toast(dbErr(res.error));btn.disabled=false;return}
  closeSheet();
  toast(old?"Changes saved.":isMgr()?"Expense saved.":"Sent for approval.");
  await loadAll();render();
  if(back)openWorker(back);
}
async function decide(ids,status,note){
  var q=sb.from("hk_expenses").update(status==="rejected"?{status:status,decision_note:nz(note)}:{status:status}).eq("status","pending");
  q=ids.length===1?q.eq("id",ids[0]):q.in("id",ids);
  var res=await q;
  if(res.error){toast(dbErr(res.error));return false}
  await loadAll();render();return true;
}
function openExpenseView(e){
  var rows=[["Date",fdate(e.date)],["Amount",fmt(e.amount),1],["Category",e.category],["Description",e.description],["Worker",e.workerName],["Paid by",e.method],["Reference",e.ref,1],["Submitted by",memberName(e.submittedBy)],["Status",e.status==="approved"?"Approved":e.status==="rejected"?"Rejected":"Waiting for approval"]];
  if(e.decisionNote)rows.push(["Reason",e.decisionNote]);
  var h=kv(rows);
  if(isMgr()&&e.status==="pending")h+='<div class="acts"><button class="btn pri" data-act="appr" data-id="'+esc(e.id)+'">Approve</button><button class="btn bad" data-act="rej" data-id="'+esc(e.id)+'">Reject</button></div>';
  if(isMgr())h+='<div class="acts"><button class="btn" data-act="edite" data-id="'+esc(e.id)+'">Edit</button></div>';
  openSheet("Expense",h);
}
function openReject(id){

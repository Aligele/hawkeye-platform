  var h='<div class="prof-top"><span class="av">'+esc(initials(w.name))+'</span><div class="grow"><h2>'+esc(w.name)+'</h2><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:4px"><span class="pill '+pillFor(w.status)+'">'+esc(w.status||"Active")+'</span><span class="wno">'+esc(w.workerNo||"")+"</span></div></div></div>";
  h+='<div class="sec" style="margin-top:0"><h3>Employment</h3>'+kv([["Job title",w.role],["Department / site",w.site],["Type",w.type],["Started",w.startDate?fdate(w.startDate):""],["Monthly pay",w.pay?fmt(w.pay):"",1],["Paid by",w.payMethod],["Pay account",w.payAccount,1]])+"</div>";
  var mk0=thisMonth();
  var paid=S.expenses.filter(function(e){return e.workerId===id&&e.category==="Salary"&&e.date&&e.date.slice(0,7)===mk0});
  var paidAmt=sum(paid,function(e){return e.amount});
  h+='<div class="sec" style="margin-top:0"><h3>Salary — '+esc(mlabel(mk0))+'</h3><div class="sum"><strong>'+(paid.length?fmt(paidAmt):(w.pay?fmt(w.pay):"No pay set"))+'</strong><span>'+(paid.length?'<span class="pill ok">Paid</span>':(w.pay?'<span class="pill warn">Due</span>':""))+"</span></div>"+(canAdd()&&w.status!=="Exited"?'<button class="btn pri" data-act="paysal" data-id="'+esc(id)+'">'+ICON.cash+(paid.length?"Record another salary payment":"Pay salary")+"</button>":"")+"</div>";
  h+='<div class="sec" style="margin-top:0"><h3>Identity</h3>'+kv([["National ID",w.idNo,1],["KRA PIN",w.kraPin,1],["Date of birth",w.dob?fdate(w.dob):""],["Gender",w.gender]])+"</div>";
  h+='<div class="sec" style="margin-top:0"><h3>Contact</h3>'+kv([["Phone",w.phone,1],["Email",w.email],["Home area",w.address]])+"</div>";
  h+='<div class="sec" style="margin-top:0"><h3>Next of kin</h3>'+kv([["Name",w.ecName],["Relationship",w.ecRel],["Phone",w.ecPhone,1]])+"</div>";
  if(w.notes)h+='<div class="sec" style="margin-top:0"><h3>Notes</h3><div class="list" style="padding:12px 14px;white-space:pre-wrap;overflow-wrap:anywhere">'+esc(w.notes)+"</div></div>";
  h+='<div class="sec" style="margin-top:0"><div class="row-h"><h3>Expenses linked to '+esc((w.name||"").split(" ")[0])+"</h3>"+(canAdd()?'<button class="btn sm" data-act="addexp" data-w="'+esc(id)+'">'+ICON.plus+"Add</button>":"")+"</div>";

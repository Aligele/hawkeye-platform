<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Hawkeye Management System</title>
<link rel="icon" href="data:image/jpeg;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;600;700&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>:root{color-scheme:light}
[hidden]{display:none!important}
html,body{margin:0}

/* Layout: one narrow column built for a phone. Sticky header, three bottom tabs
   (Overview, Workers, Expenses), and full-height sheets for forms and profiles. */
:root{
  --bg:#F5F6F3; --surface:#FFFFFF; --surface2:#EAECE7; --line:#D8DCD5;
  --ink:#121512; --ink2:#464D45; --mute:#686F66;
  --teal:#0F6E3D; --teal-ink:#FFFFFF; --amber:#B3700A;
  --ok:#0F7A43; --warn:#B3700A; --bad:#C41E2A;
  --shadow:0 1px 2px rgba(18,21,18,.06),0 10px 30px rgba(18,21,18,.12);
  --f-display:'Schibsted Grotesk',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-body:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-mono:'JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0C100D; --surface:#151B16; --surface2:#1E261F; --line:#2C362D;
    --ink:#EDF1EC; --ink2:#A5B0A4; --mute:#8D988C;
    --teal:#43B878; --teal-ink:#06200F; --amber:#E3A64A;
    --ok:#4CC488; --warn:#E3A64A; --bad:#F0707A;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.5);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0C100D; --surface:#151B16; --surface2:#1E261F; --line:#2C362D;
  --ink:#EDF1EC; --ink2:#A5B0A4; --mute:#8D988C;
  --teal:#43B878; --teal-ink:#06200F; --amber:#E3A64A;
  --ok:#4CC488; --warn:#E3A64A; --bad:#F0707A;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.5);
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{min-height:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.45;padding-inline:0;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit}
.wrap{max-width:760px;margin:0 auto;padding-inline:16px}
:focus-visible{outline:2px solid var(--teal);outline-offset:2px;border-radius:6px}

/* header */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg)}
.top::after{content:"";display:block;height:4px;background:linear-gradient(90deg,var(--teal) 0 58%,var(--bad) 58% 100%)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:12px}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand .logo{height:44px;width:auto;flex:none;border-radius:6px;background:#fff;border:1px solid var(--line)}
.brand b{font-family:var(--f-display);font-weight:700;font-size:19px;letter-spacing:.01em;display:block;line-height:1.1}
.brand span{font-size:12px;color:var(--mute);display:block;letter-spacing:.02em}
.top .acts{display:flex;gap:8px}

main{padding-block:18px 110px}
h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance}
h2{font-size:21px;font-weight:700}
h3{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
.sec{margin-top:26px;display:flex;flex-direction:column;gap:10px}
.row-h{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 16px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-weight:600;cursor:pointer}
.btn:hover{background:var(--surface2)}
.btn.pri{background:var(--teal);border-color:var(--teal);color:var(--teal-ink)}
.btn.pri:hover{filter:brightness(1.07)}
.btn.bad{color:var(--bad);border-color:color-mix(in srgb,var(--bad) 45%,var(--line))}
.btn.sm{min-height:36px;padding:0 12px;font-size:13px}
.btn svg{width:17px;height:17px}
.btn[disabled]{opacity:.55;cursor:default}

/* figures */
.figs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.fig{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px;min-width:0}
.fig small{display:block;font-size:12px;color:var(--mute);line-height:1.25}
.fig strong{display:block;font-family:var(--f-mono);font-weight:500;font-size:17px;margin-top:6px;overflow-wrap:anywhere}
.fig em{font-style:normal;font-size:12px;color:var(--ink2)}
@media (max-width:420px){.figs{grid-template-columns:1fr 1fr}.figs .fig:first-child{grid-column:1/-1}}

/* lists */
.list{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-top:1px solid var(--line);width:100%;background:none;border-inline:0;border-bottom:0;text-align:left;cursor:pointer;min-width:0}
.list>.item:first-child{border-top:0}
.item:hover{background:var(--surface2)}
.av{flex:none;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-display);font-weight:700;font-size:14px;background:color-mix(in srgb,var(--teal) 16%,var(--surface));color:var(--teal)}
.grow{flex:1;min-width:0}
.t1{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.t2{font-size:13px;color:var(--ink2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.amt{font-family:var(--f-mono);font-size:14px;white-space:nowrap}
.pill{display:inline-block;font-size:12px;font-weight:600;padding:2px 9px;border-radius:99px;white-space:nowrap}
.pill.ok{color:var(--ok);background:color-mix(in srgb,var(--ok) 14%,var(--surface))}
.pill.warn{color:var(--warn);background:color-mix(in srgb,var(--warn) 15%,var(--surface))}
.pill.mute{color:var(--mute);background:var(--surface2)}
.daybar{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);padding:14px 2px 6px}
.empty{background:var(--surface);border:1px dashed var(--line);border-radius:12px;padding:26px 18px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px;color:var(--ink2)}
.empty b{font-family:var(--f-display);font-size:17px;color:var(--ink)}

/* category bars */
.bars{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:6px 14px}
.bar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;padding:9px 0;border-top:1px solid var(--line)}
.bars .bar:first-child{border-top:0}
.bar .track{grid-column:1/-1;height:6px;border-radius:3px;background:var(--surface2);overflow:hidden}
.bar .fill{display:block;height:100%;background:var(--teal);border-radius:3px}
.bar:first-child .fill{background:var(--bad)}

/* controls */
.controls{display:flex;gap:10px;flex-wrap:wrap}
.controls>*{min-width:0}
.input,.select,.textarea{width:100%;min-height:44px;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);font-size:16px}
.textarea{min-height:84px;resize:vertical}
.controls .search{flex:1 1 200px}
.controls .select{flex:1 1 140px;width:auto}
.input:focus,.select:focus,.textarea:focus{border-color:var(--teal);outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--teal) 22%,transparent)}
.sum{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.sum strong{font-family:var(--f-mono);font-weight:500;font-size:20px}
.sum span{color:var(--ink2);font-size:13px}

/* bottom nav */
.nav{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.nav .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding-block:6px}
.tab{display:flex;flex-direction:column;align-items:center;gap:3px;padding:7px 4px;border:0;background:none;border-radius:10px;color:var(--mute);font-size:12px;font-weight:600;cursor:pointer}
.tab svg{width:22px;height:22px}
.tab[aria-current="page"]{color:var(--teal);background:color-mix(in srgb,var(--teal) 11%,var(--surface))}


/* assignments */
.seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;margin-bottom:16px;background:var(--surface2);border-radius:12px}
.seg button{min-height:40px;border:0;border-radius:9px;background:none;color:var(--ink2);font-weight:600;font-size:14px;cursor:pointer}
.seg button[aria-current="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12)}
.ftype{flex:none;width:40px;height:40px;border-radius:10px;display:grid;place-items:center;font-family:var(--f-mono);font-size:11px;font-weight:700;color:var(--teal);background:color-mix(in srgb,var(--teal) 12%,var(--surface))}
.ftype.json{color:var(--warn);background:color-mix(in srgb,var(--warn) 14%,var(--surface))}
.pre{margin:0;padding:12px;max-height:50vh;overflow:auto;background:var(--surface2);border:1px solid var(--line);border-radius:10px;font-family:var(--f-mono);font-size:12px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}
.tab{position:relative}.tab .badge{left:calc(50% + 4px)}

/* sheet */
.veil{position:fixed;inset:0;z-index:50;background:rgba(8,14,18,.55);display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--bg);width:100%;max-width:620px;height:100%;max-height:100%;overflow-y:auto;overscroll-behavior:contain;box-shadow:var(--shadow);display:flex;flex-direction:column}
@media (min-width:700px){.veil{align-items:center;padding:24px}.sheet{height:auto;max-height:100%;border-radius:16px}}
.sh-head{position:sticky;top:0;z-index:2;background:var(--bg);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;padding:calc(12px + env(safe-area-inset-top,0px)) 16px 12px}
@media (min-width:700px){.sh-head{padding-top:14px}}
.sh-head h2{font-size:19px}
.sh-body{padding:16px 16px calc(28px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:22px}
.x{width:40px;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;cursor:pointer;color:var(--ink)}
.x svg{width:18px;height:18px}
fieldset{border:0;margin:0;padding:0;min-width:0;display:flex;flex-direction:column;gap:12px}
legend{padding:0;margin-bottom:10px;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:480px){.grid2{grid-template-columns:1fr}}
.fld{display:flex;flex-direction:column;gap:5px;min-width:0}
.fld label{font-size:13px;font-weight:600;color:var(--ink2)}
.fld .req{color:var(--bad)}
.acts{display:flex;gap:10px;flex-wrap:wrap}
.acts .btn{flex:1 1 140px}

/* profile */
.prof-top{display:flex;align-items:center;gap:14px}
.prof-top .av{width:58px;height:58px;font-size:20px}
.prof-top h2{font-size:22px}
.kv{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.kv div{display:grid;grid-template-columns:128px minmax(0,1fr);gap:12px;padding:10px 14px;border-top:1px solid var(--line)}
.kv div:first-child{border-top:0}
.kv dt{color:var(--mute);font-size:13px}
.kv dd{margin:0;overflow-wrap:anywhere}
.kv dd.mono{font-family:var(--f-mono);font-size:14px}
dl.kv{margin:0}
.wno{font-family:var(--f-mono);font-size:12px;color:var(--mute)}

.banner{background:color-mix(in srgb,var(--warn) 13%,var(--surface));border:1px solid color-mix(in srgb,var(--warn) 40%,var(--line));border-radius:10px;padding:10px 12px;font-size:13px;color:var(--ink);margin-bottom:14px}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(86px + env(safe-area-inset-bottom,0px));z-index:80;background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:14px;font-weight:500;max-width:calc(100% - 32px);box-shadow:var(--shadow)}
.an-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3px 12px;padding:10px 14px;border-top:1px solid var(--line);width:100%;background:none;border-inline:0;border-bottom:0;text-align:left;cursor:pointer}
.list>.an-row:first-child{border-top:0}
.an-row:hover{background:var(--surface2)}
.an-row .track{grid-column:1/-1;height:6px;border-radius:3px;background:var(--surface2);overflow:hidden;display:flex;gap:2px}
.an-row .fill{display:block;height:100%;background:var(--teal);border-radius:3px}
.an-row .fill.b{background:var(--amber)}
.an-row .meta{grid-column:1/-1;font-size:12px;color:var(--ink2);display:flex;gap:12px;flex-wrap:wrap}
.key{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink2)}
.key i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px;background:var(--teal)}
.key i.b{background:var(--amber)}
.skel{height:58px;border-radius:12px;background:var(--surface2)}
@media (prefers-reduced-motion:no-preference){.skel{animation:pulse 1.4s ease-in-out infinite}@keyframes pulse{50%{opacity:.55}}}

.tab{position:relative;font-size:11px}
.badge{position:absolute;top:1px;left:calc(50% + 6px);min-width:18px;height:18px;border-radius:9px;background:var(--bad);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center;padding:0 5px}
.pill.bad{color:var(--bad);background:color-mix(in srgb,var(--bad) 13%,var(--surface))}
.auth{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:32px 16px}
.auth-card{width:100%;max-width:400px;display:flex;flex-direction:column;gap:18px}
.auth-brand{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}
.auth-brand img{height:112px;width:auto;border-radius:10px;background:#fff;border:1px solid var(--line)}
.auth-brand h1{font-size:24px;font-weight:700}
.auth-brand p{margin:0;color:var(--ink2);font-size:14px}
.auth-box{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;display:flex;flex-direction:column;gap:14px}
.linkbtn{background:none;border:0;color:var(--teal);font-weight:600;cursor:pointer;padding:8px;text-align:center;font-size:14px}
.err{color:var(--bad);font-size:13px;min-height:1.2em}
.note{font-size:13px;color:var(--ink2)}
.ap{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.ap .acts{padding:0 14px 12px}
.ap .item{border-top:0}
.ap+.ap{margin-top:0}
.stack{display:flex;flex-direction:column;gap:10px}
.cred{font-family:var(--f-mono);font-size:15px;overflow-wrap:anywhere}
</style>
</head>
<body>
<div id="auth" hidden><div class="auth"><div class="auth-card"><div class="auth-brand"><img src="data:image/jpeg;base64," alt="Hawkeye logo"><h1>Hawkeye</h1><p>Management System</p></div><div id="authbody"></div></div></div></div>
<div id="app" hidden>
  <header class="top"><div class="wrap">
    <div class="brand"><img class="logo" src="data:image/jpeg;base64," alt="Hawkeye logo" width="30" height="44">
      <div><b>Hawkeye</b><span>Management System</span></div></div>
    <div class="acts" id="topacts" style="gap:8px;align-items:center"></div>
  </div></header>
  <main class="wrap" id="main"></main>
  <nav class="nav" id="navbar" aria-label="Sections"><div class="wrap" id="nav"></div></nav>
</div>
<div id="layer"></div>
<div id="toastbox" aria-live="polite"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script>
(function(){
"use strict";
var CATS=["Salary","Fuel","Transport","Equipment","Repairs","Meals","Airtime & data","Rent","Utilities","Salary advance","Medical","Other"];
var TYPES=["Permanent","Contract","Casual"];
var STATUSES=["Active","On leave","Exited"];
var METHODS=["Cash","M-PESA","Bank transfer"];
var GENDERS=["Female","Male","Other"];

var SB_URL="https://enpwvgtgavtfnbhapdcf.supabase.co";
var SB_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVucHd2Z3RnYXZ0Zm5iaGFwZGNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUzNTQyODMsImV4cCI6MjEwMDkzMDI4M30.VfngBOGGaPe1iPTc82jD-_C23_b7dfi1vXjDpPcB28s";
var sb=null;
var S={tab:"overview",q:"",wstatus:"All",emonth:"",ecat:"All",amonth:"",workers:[],expenses:[],allExp:[],subs:[],stab:"exp",sfilter:"All",smem:"All",roster:[],members:[],me:null,role:"",loaded:{w:false,e:false,s:false},sheet:null,confirm:false,dl:null,authMode:"in",setupDone:null};
function isMgr(){return S.role==="admin"||S.role==="manager"}
function isAdmin(){return S.role==="admin"}
function roleName(r){return r==="admin"?"Admin":r==="manager"?"Manager":"Staff"}

function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function today(){return new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10)}
function fmt(n){return "KES "+Number(n||0).toLocaleString("en-KE",{maximumFractionDigits:0})}
function fdate(d){if(!d)return "—";var p=d.split("-").map(Number);return new Date(p[0],p[1]-1,p[2]).toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"})}
function fday(d){var p=d.split("-").map(Number);return new Date(p[0],p[1]-1,p[2]).toLocaleDateString("en-GB",{weekday:"short",day:"numeric",month:"short"})}
function mlabel(k){var p=k.split("-").map(Number);return new Date(p[0],p[1]-1,1).toLocaleDateString("en-GB",{month:"long",year:"numeric"})}
function initials(n){var p=String(n||"?").trim().split(/\s+/);return ((p[0]||"?")[0]+(p.length>1?p[p.length-1][0]:"")).toUpperCase()}
function byId(a,id){for(var i=0;i<a.length;i++)if(a[i].id===id)return a[i];return null}
function sum(a,f){var t=0;for(var i=0;i<a.length;i++)t+=Number(f(a[i])||0);return t}
function pillFor(s){return s==="Active"?"ok":s==="On leave"?"warn":"mute"}

var ICON={
  home:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.500 12 4l9 7.500"/><path d="M5.500 10v10h13V10"/></svg>',
  people:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.500"/><path d="M2.500 20c.5-3.600 3.100-5.500 6.500-5.500s6 1.900 6.500 5.500"/><path d="M16 4.800a3.500 3.500 0 0 1 0 6.400M18 14.800c2 .6 3.200 2.300 3.500 5.200"/></svg>',
  cash:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.500" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.800"/><path d="M6 9.500v.01M18 14.500v.01"/></svg>',
  chart:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
  plus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.200" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>',
  close:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.200" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>',
  check:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.500l2.800 2.800L16 9.500"/></svg>',
  file:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>',
  down:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg>'
};

/* ---------- data ---------- */
function nz(v){v=(v==null?"":String(v)).trim();return v===""?null:v}
function wFromRow(r){return {id:r.id,workerNo:r.worker_no,name:r.name,idNo:r.id_no||"",kraPin:r.kra_pin||"",dob:r.dob||"",gender:r.gender||"",phone:r.phone||"",email:r.email||"",address:r.address||"",role:r.role_title||"",site:r.site||"",type:r.emp_type||"Permanent",status:r.status||"Active",startDate:r.start_date||"",pay:Number(r.pay||0),payMethod:r.pay_method||"",payAccount:r.pay_account||"",ecName:r.ec_name||"",ecRel:r.ec_rel||"",ecPhone:r.ec_phone||"",notes:r.notes||"",createdAt:r.created_at}}
function wToRow(o){return {name:o.name,id_no:nz(o.idNo),kra_pin:nz(o.kraPin),dob:nz(o.dob),gender:nz(o.gender),phone:nz(o.phone),email:nz(o.email),address:nz(o.address),role_title:nz(o.role),site:nz(o.site),emp_type:o.type||"Permanent",status:o.status||"Active",start_date:nz(o.startDate),pay:Number(o.pay||0),pay_method:nz(o.payMethod),pay_account:nz(o.payAccount),ec_name:nz(o.ecName),ec_rel:nz(o.ecRel),ec_phone:nz(o.ecPhone),notes:nz(o.notes)}}
function mFromRow(r){return {id:r.user_id,name:r.full_name,email:r.email||"",role:r.role,active:r.active}}
function nameOf(id){if(!id)return "";var w=byId(S.workers,id)||byId(S.roster,id);return w?w.name:""}
function memberName(id){if(S.me&&id===S.me.id)return S.me.name;var m=byId(S.members,id);return m?m.name:"Staff member"}
function eFromRow(r){return {id:r.id,date:r.expense_date,amount:Number(r.amount),category:r.category,description:r.description||"",workerId:r.worker_id||"",workerName:nameOf(r.worker_id),method:r.method||"",ref:r.ref||"",status:r.status,submittedBy:r.submitted_by,decisionNote:r.decision_note||"",decidedAt:r.decided_at||"",createdAt:r.created_at}}
function dbErr(e){
  console.error(e);
  var c=e&&e.code,m=String((e&&e.message)||"");
  if(c==="23505"||/duplicate key/i.test(m))return "A worker with this ID number already exists.";
  if(c==="42501"||/row-level security|permission denied/i.test(m))return "You do not have permission to do that.";
  if(/at least one active admin/i.test(m))return "There must always be at least one active admin.";
  if(/jwt|expired/i.test(m))return "Your session ended. Sign in again.";
  return "Could not save. Check your connection and try again.";
}
async function loadAll(quiet){
  try{
    var ex=sb.from("hk_expenses").select("*").order("expense_date",{ascending:false}).limit(5000);
    if(isMgr()){
      var r=await Promise.all([sb.from("hk_workers").select("*").order("name"),ex,sb.from("hk_members").select("*").order("created_at")]);
      for(var i=0;i<r.length;i++)if(r[i].error)throw r[i].error;
      S.workers=r[0].data.map(wFromRow);
      S.members=r[2].data.map(mFromRow);
      S.allExp=r[1].data.map(eFromRow);
    }else{
      var r2=await Promise.all([sb.rpc("hk_roster"),ex]);
      for(var j=0;j<r2.length;j++)if(r2[j].error)throw r2[j].error;
      S.roster=(r2[0].data||[]).map(function(x){return {id:x.id,workerNo:x.worker_no,name:x.name,status:x.status}});
      S.allExp=r2[1].data.map(eFromRow);
    }
    S.expenses=S.allExp.filter(function(e){return e.status==="approved"});
    try{var rs=await sb.from("hk_submissions").select("*").order("created_at",{ascending:false}).limit(1000);S.subs=rs.error?[]:rs.data.map(sFromRow)}catch(e2){S.subs=[]}
    S.loaded.w=S.loaded.e=S.loaded.s=true;
    return true;
  }catch(e){
    console.error(e);S.loaded.w=S.loaded.e=true;
    if(!quiet)toast("Could not load the latest data. Check your connection.");
    return false;
  }
}
async function refresh(quiet){await loadAll(quiet);render()}
function wChoices(){return isMgr()?S.workers:S.roster}
function catsFor(){return isMgr()?CATS:CATS.filter(function(c){return c!=="Salary"})}
function pendingList(){return S.allExp.filter(function(e){return e.status==="pending"}).sort(function(a,b){return (a.createdAt||"").localeCompare(b.createdAt||"")})}

/* ---------- toast ---------- */
var tt;
function toast(m){
  var b=document.getElementById("toastbox");b.innerHTML='<div class="toast">'+esc(m)+"</div>";
  clearTimeout(tt);tt=setTimeout(function(){b.innerHTML=""},3200);
}

/* ---------- views ---------- */
function thisMonth(){return today().slice(0,7)}
function monthsList(){
  var m={};m[thisMonth()]=1;S.expenses.forEach(function(e){if(e.date)m[e.date.slice(0,7)]=1});
  return Object.keys(m).sort().reverse();
}
function canAdd(){return isMgr()}

function renderNav(){
  var nb=document.getElementById("navbar");
  if(!isMgr()){nb.hidden=true;return}
  nb.hidden=false;
  var pn=pendingList().length,nNew=S.subs.filter(function(x){return x.status==="new"}).length;
  var t=[["overview","Overview",ICON.home],["workers","Workers",ICON.people],["expenses","Expenses",ICON.cash],["approvals","Approvals",ICON.check],["files","Files",ICON.file],["analytics","Analytics",ICON.chart]];
  var el=document.getElementById("nav");
  el.style.gridTemplateColumns="repeat("+t.length+",1fr)";
  el.innerHTML=t.map(function(x){
    return '<button class="tab" data-act="tab" data-v="'+x[0]+'"'+(S.tab===x[0]?' aria-current="page"':"")+">"+x[2]+"<span>"+x[1]+"</span>"+(x[0]==="approvals"&&pn?'<b class="badge">'+pn+"</b>":"")+(x[0]==="files"&&nNew?'<b class="badge">'+nNew+"</b>":"")+"</button>";
  }).join("");
}
function renderTop(){
  var h="";
  if(S.tab==="workers"&&canAdd())h='<button class="btn pri sm" data-act="enroll">'+ICON.plus+"Enroll</button>";
  if(S.me)h+='<button class="x" data-act="account" aria-label="Account" title="'+esc(S.me.name)+'"><span style="font-weight:700;font-family:var(--f-display);font-size:13px">'+esc(initials(S.me.name))+"</span></button>";
  document.getElementById("topacts").innerHTML=h;
}
function banner(){return ""}
function loading(){return '<div class="sec"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>'}

function vOverview(){
  var act=S.workers.filter(function(w){return w.status==="Active"});
  var mk=thisMonth();
  var me=S.expenses.filter(function(e){return e.date&&e.date.slice(0,7)===mk});
  var spent=sum(me,function(e){return e.amount});
  var wage=sum(act,function(w){return w.pay});
  var h=banner();
  h+='<div class="row-h"><h2>Overview</h2><span class="wno">'+esc(mlabel(mk))+"</span></div>";
  h+='<div class="sec" style="margin-top:14px"><div class="figs">'+
    '<div class="fig"><small>Active workers</small><strong>'+act.length+'</strong><em>'+S.workers.length+" enrolled</em></div>"+
    '<div class="fig"><small>Spent this month</small><strong>'+fmt(spent)+"</strong><em>"+me.length+" entries</em></div>"+
    '<div class="fig"><small>Monthly pay of active staff</small><strong>'+fmt(wage)+"</strong><em>from worker profiles</em></div></div></div>";
  var pn0=pendingList();
  if(pn0.length)h+='<div class="list" style="margin-top:14px"><button class="item" data-act="tab" data-v="approvals"><span class="grow"><span class="t1" style="display:block">'+pn0.length+(pn0.length===1?" expense":" expenses")+' waiting for your approval</span><span class="t2" style="display:block">Tap to review</span></span><span class="amt">'+fmt(sum(pn0,function(e){return e.amount}))+"</span></button></div>";
  var ns0=S.subs.filter(function(x){return x.status==="new"});
  if(ns0.length)h+='<div class="list" style="margin-top:14px"><button class="item" data-act="tab" data-v="files"><span class="grow"><span class="t1" style="display:block">'+ns0.length+(ns0.length===1?" new assignment file":" new assignment files")+' from staff</span><span class="t2" style="display:block">Tap to open</span></span><span class="ftype">'+ICON.file.replace("<svg ",'<svg width="20" height="20" ')+"</span></button></div>";
  if(canAdd())h+='<div class="acts" style="margin-top:14px"><button class="btn pri" data-act="addexp">'+ICON.plus+'Add expense</button><button class="btn pri" data-act="paysal">'+ICON.plus+'Pay salary</button><button class="btn" data-act="enroll">'+ICON.plus+"Enroll worker</button></div>";
  var cats={};me.forEach(function(e){var c=e.category||"Other";cats[c]=(cats[c]||0)+Number(e.amount||0)});
  var ck=Object.keys(cats).sort(function(a,b){return cats[b]-cats[a]});
  h+='<div class="sec"><h3>This month by category</h3>';
  if(!S.loaded.e)h+='<div class="skel"></div>';
  else if(!ck.length)h+='<div class="empty">No expenses recorded for '+esc(mlabel(mk))+" yet.</div>";
  else{var mx=cats[ck[0]];h+='<div class="bars">'+ck.map(function(c){return '<div class="bar"><span>'+esc(c)+'</span><span class="amt">'+fmt(cats[c])+'</span><span class="track"><span class="fill" style="width:'+Math.max(3,Math.round(cats[c]/mx*100))+'%"></span></span></div>'}).join("")+"</div>"}
  h+="</div>";
  var rec=S.expenses.slice().sort(function(a,b){return (b.date||"").localeCompare(a.date||"")||(b.createdAt||"").localeCompare(a.createdAt||"")}).slice(0,5);
  h+='<div class="sec"><h3>Latest expenses</h3>';
  if(!S.loaded.e)h+='<div class="skel"></div>';
  else if(!rec.length)h+='<div class="empty">Nothing recorded yet.</div>';
  else h+='<div class="list">'+rec.map(expRow).join("")+"</div>";
  h+="</div>";
  return h;
}

function wRow(w){
  return '<button class="item" data-act="openw" data-id="'+esc(w.id)+'"><span class="av">'+esc(initials(w.name))+'</span><span class="grow"><span class="t1" style="display:block">'+esc(w.name)+'</span><span class="t2" style="display:block">'+esc([w.role,w.site].filter(Boolean).join(" · ")||w.workerNo||"")+'</span></span><span class="pill '+pillFor(w.status)+'">'+esc(w.status||"Active")+"</span></button>";
}
function vWorkers(){
  var q=S.q.trim().toLowerCase();
  var list=S.workers.filter(function(w){
    if(S.wstatus!=="All"&&w.status!==S.wstatus)return false;
    if(!q)return true;
    return [w.name,w.phone,w.idNo,w.workerNo,w.role,w.site].join(" ").toLowerCase().indexOf(q)>=0;
  }).sort(function(a,b){return (a.name||"").localeCompare(b.name||"")});
  var h=banner();
  h+='<div class="row-h"><h2>Workers</h2>'+(S.workers.length?'<span style="display:flex;gap:8px"><button class="btn sm" data-act="pdfw">'+ICON.down+'PDF</button><button class="btn sm" data-act="expw">'+ICON.down+"CSV</button></span>":"")+"</div>";
  h+='<div class="controls" style="margin-top:12px"><input class="input search" id="q" type="search" placeholder="Search name, phone, ID or role" value="'+esc(S.q)+'" aria-label="Search workers"><select class="select" id="wst" aria-label="Filter by status"><option>All</option>'+STATUSES.map(function(s){return "<option"+(S.wstatus===s?" selected":"")+">"+s+"</option>"}).join("")+"</select></div>";
  h+='<div class="sec" style="margin-top:14px">';
  if(!S.loaded.w)h+=loading();
  else if(!S.workers.length)h+='<div class="empty"><b>No workers enrolled yet</b><span>Enroll each worker once. Their details stay on file and you can link expenses to them.</span>'+(canAdd()?'<button class="btn pri" data-act="enroll">'+ICON.plus+"Enroll first worker</button>":"")+"</div>";
  else if(!list.length)h+='<div class="empty">No worker matches this search.</div>';
  else h+='<span class="wno">'+list.length+" of "+S.workers.length+' workers</span><div class="list">'+list.map(wRow).join("")+"</div>";
  h+="</div>";
  return h;
}

function expRow(e){
  var sub=[fdate(e.date),e.workerName||"",e.method||""].filter(Boolean).join(" · ");
  var pill=S.role==="staff"?'<span class="pill '+(e.status==="approved"?"ok":e.status==="rejected"?"bad":"warn")+'" style="display:block;margin-top:4px;text-align:center">'+esc(e.status==="approved"?"Approved":e.status==="rejected"?"Rejected":"Pending")+"</span>":"";
  return '<button class="item" data-act="opene" data-id="'+esc(e.id)+'"><span class="grow"><span class="t1" style="display:block">'+esc(e.description||e.category||"Expense")+'</span><span class="t2" style="display:block">'+esc((e.category||"Other")+" · "+sub)+'</span></span><span><span class="amt" style="display:block">'+fmt(e.amount)+"</span>"+pill+"</span></button>";
}
function vExpenses(){
  var ms=monthsList();
  if(!S.emonth)S.emonth=thisMonth();
  var list=S.expenses.filter(function(e){
    if(S.emonth!=="all"&&(!e.date||e.date.slice(0,7)!==S.emonth))return false;
    if(S.ecat!=="All"&&e.category!==S.ecat)return false;
    return true;
  }).sort(function(a,b){return (b.date||"").localeCompare(a.date||"")||(b.createdAt||"").localeCompare(a.createdAt||"")});
  var h=banner();
  h+='<div class="row-h"><h2>Expenses</h2>'+(S.expenses.length?'<span style="display:flex;gap:8px"><button class="btn sm" data-act="pdfe">'+ICON.down+'PDF</button><button class="btn sm" data-act="expe">'+ICON.down+"CSV</button></span>":"")+"</div>";
  if(isMgr())h+=vRecord()+vDue();
  h+='<div class="controls" style="margin-top:18px"><select class="select" id="em" aria-label="Month"><option value="all"'+(S.emonth==="all"?" selected":"")+">All time</option>"+ms.map(function(m){return '<option value="'+m+'"'+(S.emonth===m?" selected":"")+">"+esc(mlabel(m))+"</option>"}).join("")+'</select><select class="select" id="ec" aria-label="Category"><option>All</option>'+CATS.map(function(c){return "<option"+(S.ecat===c?" selected":"")+">"+esc(c)+"</option>"}).join("")+"</select></div>";
  h+='<div class="sec" style="margin-top:14px">';
  if(!S.loaded.e)h+=loading();
  else if(!S.expenses.length)h+='<div class="empty"><b>No expenses recorded yet</b><span>Record fuel, transport, equipment, advances and anything else you pay out.</span>'+(canAdd()?'<button class="btn pri" data-act="addexp">'+ICON.plus+"Add first expense</button>":"")+"</div>";
  else{
    h+='<div class="sum"><strong>'+fmt(sum(list,function(e){return e.amount}))+"</strong><span>"+list.length+(list.length===1?" entry":" entries")+" · "+(S.emonth==="all"?"all time":esc(mlabel(S.emonth)))+"</span></div>";
    if(!list.length)h+='<div class="empty">Nothing matches these filters.</div>';
    else{
      var cur="",grp="";
      list.forEach(function(e){
        if(e.date!==cur){if(grp)h+=grp+"</div>";cur=e.date;h+='<div class="daybar">'+esc(e.date?fday(e.date):"No date")+"</div>";grp='<div class="list">'}
        grp+=expRow(e);
      });
      if(grp)h+=grp+"</div>";
    }
  }
  h+="</div>";
  return h;
}

function inPeriod(e){return S.amonth==="all"||(e.date&&e.date.slice(0,7)===S.amonth)}
function pct(a,b){return b?Math.round(a/b*100):0}
function vAnalytics(){
  if(!S.amonth)S.amonth=thisMonth();
  var ms=monthsList();
  var ex=S.expenses.filter(inPeriod);
  var total=sum(ex,function(e){return e.amount});
  var sal=sum(ex.filter(function(e){return e.category==="Salary"}),function(e){return e.amount});
  var other=total-sal;
  var label=S.amonth==="all"?"All time":mlabel(S.amonth);
  var h=banner();
  h+='<div class="row-h"><h2>Analytics</h2><select class="select" id="am" style="width:auto;min-width:160px" aria-label="Period"><option value="all"'+(S.amonth==="all"?" selected":"")+">All time</option>"+ms.map(function(m){return '<option value="'+m+'"'+(S.amonth===m?" selected":"")+">"+esc(mlabel(m))+"</option>"}).join("")+"</select></div>";
  if(!S.loaded.e||!S.loaded.w)return h+loading();
  if(!S.expenses.length)return h+'<div class="sec"><div class="empty"><b>No expenses to analyse yet</b><span>Record salary payments and other expenses, then the breakdown by category and by worker appears here.</span>'+(canAdd()?'<button class="btn pri" data-act="addexp">'+ICON.plus+"Add expense</button>":"")+"</div></div>"+(S.workers.length?vReports():"");
  h+='<div class="sec" style="margin-top:14px"><div class="figs"><div class="fig"><small>Total spent</small><strong>'+fmt(total)+"</strong><em>"+esc(label)+'</em></div><div class="fig"><small>Salaries paid</small><strong>'+fmt(sal)+"</strong><em>"+pct(sal,total)+'% of total</em></div><div class="fig"><small>Other expenses</small><strong>'+fmt(other)+"</strong><em>"+pct(other,total)+"% of total</em></div></div></div>";
  // by category
  var cats={};ex.forEach(function(e){var c=e.category||"Other";var o=cats[c]||(cats[c]={n:0,t:0});o.n++;o.t+=Number(e.amount||0)});
  var ck=Object.keys(cats).sort(function(a,b){return cats[b].t-cats[a].t});
  h+='<div class="sec"><h3>By expense category</h3>';
  if(!ck.length)h+='<div class="empty">No expenses in '+esc(label)+".</div>";
  else{var mx=cats[ck[0]].t;h+='<div class="list">'+ck.map(function(c){var o=cats[c];return '<button class="an-row" data-act="catfilter" data-c="'+esc(c)+'"><span class="t1">'+esc(c)+'</span><span class="amt">'+fmt(o.t)+'</span><span class="track"><span class="fill'+(c==="Salary"?" b":"")+'" style="width:'+Math.max(2,Math.round(o.t/mx*100))+'%"></span></span><span class="meta"><span>'+pct(o.t,total)+"% of total</span><span>"+o.n+(o.n===1?" entry":" entries")+"</span><span>avg "+fmt(o.t/o.n)+"</span></span></button>"}).join("")+"</div><span class=\"wno\">Tap a category to see its entries.</span>"}
  h+="</div>";
  // by worker
  var rows=S.workers.filter(function(w){return w.status!=="Exited"||ex.some(function(e){return e.workerId===w.id})}).map(function(w){
    var mine=ex.filter(function(e){return e.workerId===w.id});
    var s1=sum(mine.filter(function(e){return e.category==="Salary"}),function(e){return e.amount});
    var t=sum(mine,function(e){return e.amount});
    return {w:w,sal:s1,oth:t-s1,t:t,n:mine.length};
  }).sort(function(a,b){return b.t-a.t||(a.w.name||"").localeCompare(b.w.name||"")});
  var unlinked=sum(ex.filter(function(e){return !e.workerId}),function(e){return e.amount});
  h+='<div class="sec"><h3>By worker</h3>';
  if(!rows.length)h+='<div class="empty">No workers enrolled yet.</div>';
  else{
    var wm=Math.max.apply(null,rows.map(function(r){return r.t}))||1;
    h+='<div class="key"><span><i class="b"></i>Salary</span><span><i></i>Other expenses</span></div><div class="list">'+rows.map(function(r){
      var due=S.amonth!=="all"&&r.w.status==="Active"&&r.w.pay>0&&r.sal<=0;
      return '<button class="an-row" data-act="openw" data-id="'+esc(r.w.id)+'"><span class="t1">'+esc(r.w.name)+'</span><span class="amt">'+fmt(r.t)+'</span><span class="track" style="width:'+Math.max(r.t?2:0,Math.round(r.t/wm*100))+'%"><span class="fill b" style="flex:'+r.sal+'"></span><span class="fill" style="flex:'+r.oth+'"></span></span><span class="meta"><span>Salary '+fmt(r.sal)+"</span><span>Other "+fmt(r.oth)+"</span><span>"+r.n+(r.n===1?" entry":" entries")+"</span>"+(due?'<span class="pill warn">Salary due</span>':"")+"</span></button>"}).join("")+"</div>";
    if(unlinked)h+='<span class="wno">Not linked to a worker: '+fmt(unlinked)+"</span>";
  }
  h+="</div>";
  // monthly trend
  var tm={};S.expenses.forEach(function(e){if(!e.date)return;var k=e.date.slice(0,7);var o=tm[k]||(tm[k]={s:0,o:0});if(e.category==="Salary")o.s+=Number(e.amount||0);else o.o+=Number(e.amount||0)});
  var mk=Object.keys(tm).sort().reverse().slice(0,6);
  var tx=Math.max.apply(null,mk.map(function(k){return tm[k].s+tm[k].o}))||1;
  h+='<div class="sec"><h3>Month by month</h3><div class="list">'+mk.map(function(k){var o=tm[k];return '<div class="an-row" style="cursor:default"><span class="t1">'+esc(mlabel(k))+'</span><span class="amt">'+fmt(o.s+o.o)+'</span><span class="track" style="width:'+Math.max(2,Math.round((o.s+o.o)/tx*100))+'%"><span class="fill b" style="flex:'+o.s+'"></span><span class="fill" style="flex:'+o.o+'"></span></span><span class="meta"><span>Salary '+fmt(o.s)+"</span><span>Other "+fmt(o.o)+"</span></span></div>"}).join("")+"</div></div>";
  h+=vReports();
  return h;
}

function apRow(e,withActions){
  var sub=[fdate(e.date),e.workerName||"",memberName(e.submittedBy)].filter(Boolean).join(" · ");
  var h='<div class="ap"><button class="item" data-act="viewe" data-id="'+esc(e.id)+'"><span class="grow"><span class="t1" style="display:block">'+esc(e.description||e.category)+'</span><span class="t2" style="display:block">'+esc(e.category+" · "+sub)+'</span></span><span class="amt">'+fmt(e.amount)+"</span></button>";
  if(withActions)h+='<div class="acts"><button class="btn pri sm" data-act="appr" data-id="'+esc(e.id)+'">Approve</button><button class="btn bad sm" data-act="rej" data-id="'+esc(e.id)+'">Reject</button></div>';
  return h+"</div>";
}
function vApprovals(){
  var p=pendingList();
  var h='<div class="row-h"><h2>Approvals</h2>'+(p.length>1?'<button class="btn pri sm" data-act="apprall">Approve all ('+p.length+")</button>":"")+"</div>";
  if(!S.loaded.e)return h+loading();
  h+='<div class="sec" style="margin-top:14px">';
  if(!p.length)h+='<div class="empty"><b>Nothing waiting</b><span>Expenses submitted by staff appear here for you to approve or reject.</span></div>';
  else h+='<div class="sum"><strong>'+fmt(sum(p,function(e){return e.amount}))+"</strong><span>"+p.length+(p.length===1?" expense":" expenses")+' waiting</span></div><div class="stack">'+p.map(function(e){return apRow(e,true)}).join("")+"</div>";
  h+="</div>";
  var dec=S.allExp.filter(function(e){return e.status!=="pending"&&e.submittedBy!==S.me.id&&e.decidedAt}).sort(function(a,b){return (b.decidedAt||"").localeCompare(a.decidedAt||"")}).slice(0,8);
  if(dec.length)h+='<div class="sec"><h3>Recently decided</h3><div class="list">'+dec.map(function(e){return '<button class="item" data-act="viewe" data-id="'+esc(e.id)+'"><span class="grow"><span class="t1" style="display:block">'+esc(e.description||e.category)+'</span><span class="t2" style="display:block">'+esc(memberName(e.submittedBy)+" · "+fdate(e.date))+'</span></span><span><span class="amt" style="display:block">'+fmt(e.amount)+'</span><span class="pill '+(e.status==="approved"?"ok":"bad")+'" style="display:block;margin-top:4px;text-align:center">'+(e.status==="approved"?"Approved":"Rejected")+"</span></span></button>"}).join("")+"</div></div>";
  return h;
}
function vStaff(){return segStaff()+(S.stab==="asg"?vAssignments():vStaff0())}
function vStaff0(){
  var mine=S.allExp.slice().sort(byDateDesc);
  var pend=mine.filter(function(e){return e.status==="pending"});
  var rej=mine.filter(function(e){return e.status==="rejected"});
  var mk=thisMonth();
  var appM=mine.filter(function(e){return e.status==="approved"&&e.date&&e.date.slice(0,7)===mk});
  var h='<div class="row-h"><div><h2>My expenses</h2><span class="wno">'+esc(S.me.name)+"</span></div>"+'<button class="btn pri sm" data-act="addexp">'+ICON.plus+"Add expense</button></div>";
  if(!S.loaded.e)return h+loading();
  h+='<div class="sec" style="margin-top:14px"><div class="figs">'+
    '<div class="fig"><small>Waiting for approval</small><strong>'+fmt(sum(pend,function(e){return e.amount}))+"</strong><em>"+pend.length+(pend.length===1?" entry":" entries")+"</em></div>"+
    '<div class="fig"><small>Approved this month</small><strong>'+fmt(sum(appM,function(e){return e.amount}))+"</strong><em>"+appM.length+(appM.length===1?" entry":" entries")+"</em></div>"+
    '<div class="fig"><small>Rejected</small><strong>'+rej.length+"</strong><em>see the reason inside</em></div></div></div>";
  h+='<div class="sec">';
  if(!mine.length)h+='<div class="empty"><b>No expenses yet</b><span>Add what you spent. A manager will approve it.</span><button class="btn pri" data-act="addexp">'+ICON.plus+"Add expense</button></div>";
  else{
    var cur="",grp="";
    mine.forEach(function(e){
      if(e.date!==cur){if(grp)h+=grp+"</div>";cur=e.date;h+='<div class="daybar">'+esc(e.date?fday(e.date):"No date")+"</div>";grp='<div class="list">'}
      grp+=expRow(e);
    });
    if(grp)h+=grp+"</div>";
  }
  h+="</div>";
  return h;
}

function render(){
  var m=document.getElementById("main");
  var f=document.activeElement,keep=f&&f.id==="q"?f.selectionStart:null;
  m.innerHTML=!isMgr()?vStaff():S.tab==="workers"?vWorkers():S.tab==="expenses"?vExpenses():S.tab==="approvals"?vApprovals():S.tab==="files"?vFiles():S.tab==="analytics"?vAnalytics():vOverview();
  renderNav();renderTop();
  if(keep!==null){var q=document.getElementById("q");if(q){q.focus();try{q.setSelectionRange(keep,keep)}catch(e){}}}
}

/* ---------- sheets ---------- */
function openSheet(title,body){
  S.confirm=false;
  document.getElementById("layer").innerHTML='<div class="veil" data-act="veil"><div class="sheet" role="dialog" aria-modal="true" aria-label="'+esc(title)+'"><div class="sh-head"><h2>'+esc(title)+'</h2><button class="x" data-act="close" aria-label="Close">'+ICON.close+'</button></div><div class="sh-body">'+body+"</div></div></div>";
  document.body.style.overflow="hidden";
  var s=document.querySelector(".sheet");if(s)s.scrollTop=0;
}
function closeSheet(){document.getElementById("layer").innerHTML="";document.body.style.overflow="";S.sheet=null;S.confirm=false}

function opts(arr,val){return arr.map(function(o){return "<option"+(o===val?" selected":"")+">"+esc(o)+"</option>"}).join("")}
function fld(label,name,type,val,extra){
  extra=extra||{};
  return '<div class="fld"><label for="f_'+name+'">'+label+(extra.req?' <span class="req">*</span>':"")+'</label><input class="input" id="f_'+name+'" name="'+name+'" type="'+type+'" value="'+esc(val)+'"'+(extra.req?" required":"")+(extra.ph?' placeholder="'+esc(extra.ph)+'"':"")+(extra.mode?' inputmode="'+extra.mode+'"':"")+(extra.auto?' autocomplete="'+extra.auto+'"':' autocomplete="off"')+(type==="number"?' min="0" step="any"':"")+"></div>";
}
function sel(label,name,arr,val,blank){
  return '<div class="fld"><label for="f_'+name+'">'+label+'</label><select class="select" id="f_'+name+'" name="'+name+'">'+(blank?'<option value="">'+blank+"</option>":"")+opts(arr,val)+"</select></div>";
}


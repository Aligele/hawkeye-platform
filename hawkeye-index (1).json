    '<div class="grid2">'+fld("Date of birth","dob","date",w.dob)+sel("Gender","gender",GENDERS,w.gender,"Select")+"</div></fieldset>";
  h+='<fieldset style="margin-top:22px"><legend>Contact</legend><div class="grid2">'+fld("Phone","phone","tel",w.phone,{mode:"tel",ph:"07…"})+fld("Email","email","email",w.email)+"</div>"+fld("Home area / county","address","text",w.address)+"</fieldset>";
  h+='<fieldset style="margin-top:22px"><legend>Employment</legend><div class="grid2">'+fld("Job title","role","text",w.role)+fld("Department or site","site","text",w.site)+"</div>"+
    '<div class="grid2">'+sel("Employment type","type",TYPES,w.type||"Permanent")+sel("Status","status",STATUSES,w.status||"Active")+"</div>"+

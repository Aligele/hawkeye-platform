function showCreds(name,email,pw,what){
  openSheet(what,'<p class="note">Give these to '+esc(name)+'. Send them privately.</p>'+kv([["Email",email,1],["Password",pw,1]])+'<div class="acts"><button class="btn pri" data-act="copycreds" data-v="'+esc("Hawkeye sign-in\nEmail: "+email+"\nPassword: "+pw)+'">Copy</button><button class="btn" data-act="team">Back to team</button></div>');
}
async function callFn(body){
  var tok=SB_KEY;
  try{var s=await sb.auth.getSession();if(s.data&&s.data.session)tok=s.data.session.access_token}catch(e){}
  var res=await fetch(SB_URL+"/functions/v1/hawkeye-admin",{method:"POST",headers:{"Content-Type":"application/json",apikey:SB_KEY,Authorization:"Bearer "+tok},body:JSON.stringify(body)});
  var j={};try{j=await res.json()}catch(e){}
  if(!res.ok&&!j.error)j.error="Request failed ("+res.status+")";
  return j;
}

/* ---------- sign in ---------- */
function authMsg(m){var e=document.getElementById("autherr");if(e)e.textContent=m||""}
function renderAuth(){
  var b=document.getElementById("authbody");
  var link=S.authMode==="in"?(S.setupDone===false?'<button class="linkbtn" data-act="authmode" data-v="setup">First time? Set up Hawkeye</button>':""):'<button class="linkbtn" data-act="authmode" data-v="in">Back to sign in</button>';
  if(S.authMode==="in")
    b.innerHTML='<form id="fsignin" class="auth-box" novalidate><div class="fld"><label for="a_em">Email</label><input class="input" id="a_em" name="email" type="email" autocomplete="username" autocapitalize="off"></div><div class="fld"><label for="a_pw">Password</label><input class="input" id="a_pw" name="password" type="password" autocomplete="current-password"></div><div class="err" id="autherr" role="alert"></div><button class="btn pri" type="submit">Sign in</button></form>'+link;
  else if(S.authMode==="noaccess")
    b.innerHTML='<div class="auth-box"><b>No access yet</b><span class="note">'+esc(S.noAccessEmail||"")+' is not a Hawkeye member, or has been deactivated. Ask an admin to add you.</span><button class="btn" data-act="signout">Sign out</button></div>';
  else
    b.innerHTML='<form id="fsetup" class="auth-box" novalidate><b>Set up Hawkeye</b><span class="note">Create the first admin account. You need the setup code you were given.</span><div class="fld"><label for="s_code">Setup code</label><input class="input" id="s_code" name="code" type="text" autocomplete="off" autocapitalize="characters"></div><div class="fld"><label for="s_fn">Your full name</label><input class="input" id="s_fn" name="full_name" type="text" autocomplete="name"></div><div class="fld"><label for="s_em">Email</label><input class="input" id="s_em" name="email" type="email" autocomplete="username" autocapitalize="off"></div><div class="fld"><label for="s_pw">Password (8 or more characters)</label><input class="input" id="s_pw" name="password" type="password" autocomplete="new-password"></div><div class="err" id="autherr" role="alert"></div><button class="btn pri" type="submit">Create admin account</button></form>'+link;
}
function showAuth(mode){
  document.getElementById("app").hidden=true;document.getElementById("auth").hidden=false;
  closeSheet();S.authMode=mode||"in";renderAuth();
}
async function doSignIn(email,password){
  var r=await sb.auth.signInWithPassword({email:email.trim(),password:password});
  if(r.error){authMsg(/invalid/i.test(r.error.message)?"Email or password is not correct.":"Could not sign in. Check your connection and try again.");return false}
  await boot();return true;
}
async function boot(){
  var u=await sb.auth.getUser();
  if(u.error||!u.data||!u.data.user){showAuth("in");return}
  var m=await sb.from("hk_members").select("*").eq("user_id",u.data.user.id).maybeSingle();
  if(m.error||!m.data||!m.data.active){S.noAccessEmail=u.data.user.email;showAuth("noaccess");return}
  S.me={id:u.data.user.id,name:m.data.full_name,email:m.data.email||u.data.user.email};
  S.role=m.data.role;
  S.tab=isMgr()?"overview":"staff";
  S.loaded={w:false,e:false};S.emonth=thisMonth();S.amonth="";
  document.getElementById("auth").hidden=true;document.getElementById("app").hidden=false;
  render();
  await loadAll();render();
  startPoll();
}
var pollT=null;
function startPoll(){
  clearInterval(pollT);
  pollT=setInterval(function(){if(!document.hidden&&S.me&&!document.querySelector(".veil")&&!document.querySelector("#main input:focus"))refresh(true)},60000);
  document.addEventListener("visibilitychange",function(){if(!document.hidden&&S.me&&!document.querySelector(".veil"))refresh(true)});
}
async function signOut(){
  clearInterval(pollT);
  try{await sb.auth.signOut()}catch(e){}
  S.me=null;S.role="";S.workers=[];S.expenses=[];S.allExp=[];S.roster=[];S.members=[];S.subs=[];S.stab="exp";S.loaded={w:false,e:false,s:false};
  showAuth("in");
}

/* ---------- download (browser) ---------- */
S.dl={save:async function(r){
  var ext=(r.filename.split(".").pop()||"").toLowerCase();
  var type=ext==="pdf"?"application/pdf":ext==="csv"?"text/csv;charset=utf-8":ext==="json"?"application/json":"application/octet-stream";
  var blob=new Blob([r.data],{type:type});
  var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=r.filename;document.body.appendChild(a);a.click();
  setTimeout(function(){URL.revokeObjectURL(a.href);a.remove()},4000);
  return {status:"saved"};
}};

/* ---------- export ---------- */
function csvCell(v){
  var s=String(v==null?"":v);
  if(/^[=+\-@\t\r]/.test(s))s="'"+s;
  return '"'+s.replace(/"/g,'""')+'"';
}
async function exportCsv(name,head,rows){
  if(!S.dl){toast("Exporting is not available in this view.");return}
  var txt=[head].concat(rows).map(function(r){return r.map(csvCell).join(",")}).join("\r\n");
  try{await S.dl.save({filename:name,data:"﻿"+txt})}
  catch(e){if(e&&e.code!=="declined")toast("Could not export the file.")}
}
function exportWorkers(){
  exportCsv("hawkeye-workers-"+today()+".csv",["Worker no","Name","National ID","KRA PIN","Date of birth","Gender","Phone","Email","Home area","Job title","Department or site","Type","Status","Start date","Monthly pay (KES)","Paid by","Pay account","Next of kin","Relationship","Next of kin phone","Notes"],
    S.workers.slice().sort(function(a,b){return (a.workerNo||"").localeCompare(b.workerNo||"")}).map(function(w){return [w.workerNo,w.name,w.idNo,w.kraPin,w.dob,w.gender,w.phone,w.email,w.address,w.role,w.site,w.type,w.status,w.startDate,w.pay,w.payMethod,w.payAccount,w.ecName,w.ecRel,w.ecPhone,w.notes]}));
}
function exportExpenses(){
  exportCsv("hawkeye-expenses-"+today()+".csv",["Date","Amount (KES)","Category","Description","Worker","Paid by","Reference"],
    S.expenses.slice().sort(function(a,b){return (a.date||"").localeCompare(b.date||"")}).map(function(e){return [e.date,e.amount,e.category,e.description,e.workerName,e.method,e.ref]}));
}


/* ---------- PDF reports ---------- */
var TEAL=[15,110,61],GREYROW=[244,246,243];
function pt(x){return String(x==null?"":x).replace(/[–—]/g,"-").replace(/[‘’]/g,"'").replace(/[“”]/g,'"').replace(/ /g," ")}
function nf(n){return Number(n||0).toLocaleString("en-US",{maximumFractionDigits:0})}
function periodList(m){return S.expenses.filter(function(e){return m==="all"||(e.date&&e.date.slice(0,7)===m)})}
function byDateDesc(a,b){return (b.date||"").localeCompare(a.date||"")||(b.createdAt||"").localeCompare(a.createdAt||"")}
function periodName(m){return m==="all"?"All time":mlabel(m)}
function pdfReady(){return !!(window.jspdf&&window.jspdf.jsPDF)}
function newDoc(){var J=window.jspdf.jsPDF;return new J({orientation:"landscape",unit:"pt",format:"a4"})}
function secStart(doc,first,title,sub){
  if(!first)doc.addPage();
  var W=doc.internal.pageSize.getWidth();
  var logo=document.querySelector(".logo");
  try{if(logo)doc.addImage(logo.src,"JPEG",40,28,30,44)}catch(e){}
  doc.setFont("helvetica","bold");doc.setFontSize(16);doc.setTextColor(18,21,18);doc.text("Hawkeye Management System",82,48);
  doc.setFont("helvetica","normal");doc.setFontSize(11);doc.setTextColor(78,94,105);doc.text(pt(title),82,66);
  doc.setFontSize(9);doc.text("Generated "+fdate(today()),W-40,48,{align:"right"});
  if(sub)doc.text(pt(sub),W-40,62,{align:"right"});
  doc.setLineWidth(2);doc.setDrawColor(15,110,61);doc.line(40,82,W*0.6,82);doc.setDrawColor(196,30,42);doc.line(W*0.6,82,W-40,82);doc.setLineWidth(0.2);
  return 96;
}
function tbl(doc,y,head,body,foot,right){
  var cs={};(right||[]).forEach(function(i){cs[i]={halign:"right"}});
  doc.autoTable({startY:y,head:[head],body:body.length?body:[[{content:"No entries for this selection.",colSpan:head.length,styles:{halign:"center",textColor:[106,120,130]}}]],foot:foot&&body.length?[foot]:undefined,showFoot:"lastPage",theme:"striped",
    styles:{font:"helvetica",fontSize:9,cellPadding:4,textColor:[18,21,18],overflow:"linebreak"},
    headStyles:{fillColor:TEAL,textColor:255,fontStyle:"bold"},
    footStyles:{fillColor:[234,236,231],textColor:[18,21,18],fontStyle:"bold"},
    alternateRowStyles:{fillColor:GREYROW},columnStyles:cs,didParseCell:function(d){if((right||[]).indexOf(d.column.index)>=0&&d.cell.colSpan===1)d.cell.styles.halign="right"},margin:{top:40,left:40,right:40,bottom:40}});
  return doc.lastAutoTable.finalY;
}
function sExpenses(doc,first,title,sub,list){
  var y=secStart(doc,first,title,sub);list=list.slice().sort(byDateDesc);
  var rows=list.map(function(e){return [fdate(e.date),pt(e.category),pt(e.description),pt(e.workerName),pt(e.method),pt(e.ref),nf(e.amount)]});
  tbl(doc,y,["Date","Category","Description","Worker","Paid by","Reference","Amount (KES)"],rows,["","","","","",list.length+(list.length===1?" entry":" entries"),nf(sum(list,function(e){return e.amount}))],[6]);
}
function sCategories(doc,first,m){
  var y=secStart(doc,first,"Expenses by category",periodName(m));
  var ex=periodList(m),cats={};ex.forEach(function(e){var c=e.category||"Other";var o=cats[c]||(cats[c]={n:0,t:0});o.n++;o.t+=Number(e.amount||0)});
  var total=sum(ex,function(e){return e.amount});
  var ck=Object.keys(cats).sort(function(a,b){return cats[b].t-cats[a].t});
  tbl(doc,y,["Category","Entries","Total (KES)","Share","Average (KES)"],ck.map(function(c){var o=cats[c];return [pt(c),o.n,nf(o.t),pct(o.t,total)+"%",nf(o.t/o.n)]}),["Total",ex.length,nf(total),"100%",""],[1,2,3,4]);
}
function sWorkerSummary(doc,first,m){
  var y=secStart(doc,first,"Summary by worker",periodName(m));
  var ex=periodList(m);
  var rows=S.workers.filter(function(w){return w.status!=="Exited"||ex.some(function(e){return e.workerId===w.id})}).map(function(w){
    var mine=ex.filter(function(e){return e.workerId===w.id});
    var s1=sum(mine.filter(function(e){return e.category==="Salary"}),function(e){return e.amount});
    var t=sum(mine,function(e){return e.amount});
    var st=m==="all"?"-":(w.status!=="Active"?"-":(s1>0?"Paid":(w.pay>0?"Due":"-")));
    return {w:w,s1:s1,o:t-s1,t:t,n:mine.length,st:st};
  }).sort(function(a,b){return b.t-a.t||(a.w.name||"").localeCompare(b.w.name||"")});
  tbl(doc,y,["Worker","No.","Monthly pay (KES)","Salary paid (KES)","Other expenses (KES)","Total (KES)","Entries","Salary status"],
    rows.map(function(r){return [pt(r.w.name),pt(r.w.workerNo),nf(r.w.pay),nf(r.s1),nf(r.o),nf(r.t),r.n,r.st]}),
    ["Total","",nf(sum(rows,function(r){return r.w.pay})),nf(sum(rows,function(r){return r.s1})),nf(sum(rows,function(r){return r.o})),nf(sum(rows,function(r){return r.t})),sum(rows,function(r){return r.n}),""],[2,3,4,5,6]);
}
function sRegister(doc,first){
  var y=secStart(doc,first,"Workers register",S.workers.length+" enrolled");
  var list=S.workers.slice().sort(function(a,b){return (a.workerNo||"").localeCompare(b.workerNo||"")});
  tbl(doc,y,["No.","Name","National ID","Phone","Job title","Department / site","Type","Status","Started","Monthly pay (KES)"],
    list.map(function(w){return [pt(w.workerNo),pt(w.name),pt(w.idNo),pt(w.phone),pt(w.role),pt(w.site),pt(w.type),pt(w.status),w.startDate?fdate(w.startDate):"",nf(w.pay)]}),
    ["","Active staff: "+list.filter(function(w){return w.status==="Active"}).length,"","","","","","","",nf(sum(list.filter(function(w){return w.status==="Active"}),function(w){return w.pay}))],[9]);
}
var REPORTS=[
  {id:"all",name:"Complete report",file:"complete-report"},
  {id:"exp",name:"All expenses",file:"expenses"},
  {id:"sal",name:"Salary payments",file:"salary-payments"},
  {id:"rent",name:"Rent payments",file:"rent-payments"},
  {id:"cat",name:"Category summary",file:"category-summary"},
  {id:"wrk",name:"Summary by worker",file:"worker-summary"},
  {id:"reg",name:"Workers register",file:"workers-register"}
];
function catList(m,c){return periodList(m).filter(function(e){return e.category===c})}
function repDesc(r,m){
  var ex=periodList(m),sl=catList(m,"Salary"),rt=catList(m,"Rent");
  var amt=function(l){return l.length+(l.length===1?" entry":" entries")+" · "+fmt(sum(l,function(e){return e.amount}))};
  if(r.id==="all")return "All six reports below in one file";
  if(r.id==="exp")return amt(ex);
  if(r.id==="sal")return amt(sl);
  if(r.id==="rent")return amt(rt);
  if(r.id==="cat")return "Totals, share and average per category";
  if(r.id==="wrk")return "Salary and other expenses for each worker";
  return S.workers.length+(S.workers.length===1?" worker":" workers")+" with contact and pay details";
}
function addReport(doc,id,m,first){
  var p=periodName(m);
  if(id==="exp")sExpenses(doc,first,"All expenses",p,periodList(m));
  if(id==="sal")sExpenses(doc,first,"Salary payments",p,catList(m,"Salary"));
  if(id==="rent")sExpenses(doc,first,"Rent payments",p,catList(m,"Rent"));
  if(id==="cat")sCategories(doc,first,m);
  if(id==="wrk")sWorkerSummary(doc,first,m);
  if(id==="reg")sRegister(doc,first);
}
function finishDoc(doc){
  var n=doc.getNumberOfPages(),W=doc.internal.pageSize.getWidth(),H=doc.internal.pageSize.getHeight();
  for(var i=1;i<=n;i++){doc.setPage(i);doc.setFont("helvetica","normal");doc.setFontSize(8);doc.setTextColor(106,120,130);doc.text("Hawkeye Management System - confidential, contains personal data",40,H-20);doc.text("Page "+i+" of "+n,W-40,H-20,{align:"right"})}
}
async function savePdf(doc,name){
  if(!S.dl){toast("Downloading is not available in this view.");return}
  finishDoc(doc);
  try{await S.dl.save({filename:name,data:doc.output("arraybuffer")})}
  catch(e){if(e&&e.code!=="declined")toast("Could not save the PDF.")}
}
function guard(){if(!pdfReady()){toast("The PDF tool did not load. Check your connection and reload.");return false}return true}
async function downloadReport(id){
  if(!guard())return;
  var m=S.amonth||thisMonth(),r=REPORTS.filter(function(x){return x.id===id})[0],doc=newDoc();
  if(id==="all"){["reg","wrk","cat","exp","sal","rent"].forEach(function(k,i){addReport(doc,k,m,i===0)})}
  else addReport(doc,id,m,true);
  await savePdf(doc,"hawkeye-"+r.file+"-"+(m==="all"?"all-time":m)+".pdf");
}
async function downloadExpensesView(){
  if(!guard())return;
  var m=S.emonth||thisMonth();
  var list=periodList(m).filter(function(e){return S.ecat==="All"||e.category===S.ecat});
  var doc=newDoc();sExpenses(doc,true,"Expenses",periodName(m)+(S.ecat!=="All"?" · "+S.ecat:""),list);
  await savePdf(doc,"hawkeye-expenses-"+(m==="all"?"all-time":m)+(S.ecat!=="All"?"-"+S.ecat.toLowerCase().replace(/[^a-z0-9]+/g,"-"):"")+".pdf");
}
async function downloadRegister(){
  if(!guard())return;var doc=newDoc();sRegister(doc,true);await savePdf(doc,"hawkeye-workers-register-"+today()+".pdf");
}
function vReports(){
  var m=S.amonth||thisMonth();
  return '<div class="sec"><h3>Download reports (PDF)</h3><div class="list">'+REPORTS.map(function(r){
    return '<div class="item" style="cursor:default"><span class="grow"><span class="t1" style="display:block">'+esc(r.name)+'</span><span class="t2" style="display:block">'+esc(repDesc(r,m))+'</span></span><button class="btn sm" data-act="pdf" data-r="'+r.id+'">'+ICON.down+"PDF</button></div>";
  }).join("")+'</div><span class="wno">Expense reports cover '+esc(periodName(m))+", the period chosen above, and include approved expenses only. The workers register always lists everyone.</span></div>";
}

/* ---------- assignments (file submissions) ---------- */
var BUCKET="hk-assignments",MAXFILE=10*1024*1024;
function sFromRow(r){return {id:r.id,title:r.title,note:r.note||"",path:r.file_path,fileName:r.file_name,type:r.file_type,size:Number(r.file_size||0),status:r.status,by:r.submitted_by,createdAt:r.created_at,reviewedBy:r.reviewed_by||"",reviewedAt:r.reviewed_at||"",reviewNote:r.review_note||""}}
function fsize(n){return n<1024?n+" B":n<1048576?Math.round(n/1024)+" KB":(n/1048576).toFixed(1)+" MB"}
function ldate(iso){if(!iso)return "—";var d=new Date(iso);return d.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"})+", "+d.toLocaleTimeString("en-GB",{hour:"2-digit",minute:"2-digit"})}
function segStaff(){
  var n=S.subs.filter(function(x){return x.status==="new"}).length;
  return '<div class="seg"><button data-act="stab" data-v="exp"'+(S.stab!=="asg"?' aria-current="true"':"")+'>Expenses</button><button data-act="stab" data-v="asg"'+(S.stab==="asg"?' aria-current="true"':"")+">Assignments</button></div>";
}
function subRow(x,mgr){
  var who=mgr?memberName(x.by)+" · ":"";
  var pill=x.status==="reviewed"?'<span class="pill ok">Reviewed</span>':'<span class="pill warn">'+(mgr?"New":"Sent")+"</span>";
  return '<button class="item" data-act="opens" data-id="'+esc(x.id)+'"><span class="ftype '+esc(x.type)+'">'+esc(x.type.toUpperCase())+'</span><span class="grow"><span class="t1" style="display:block">'+esc(x.title)+'</span><span class="t2" style="display:block">'+esc(who+ldate(x.createdAt)+" · "+fsize(x.size))+"</span></span>"+pill+"</button>";
}
function vAssignments(){
  var mine=S.subs.slice().sort(function(a,b){return (b.createdAt||"").localeCompare(a.createdAt||"")});
  var h='<div class="row-h"><div><h2>My assignments</h2><span class="wno">'+esc(S.me.name)+'</span></div><button class="btn pri sm" data-act="subnew">'+ICON.plus+"Submit file</button></div>";
  if(!S.loaded.s)return h+loading();
  h+='<div class="sec" style="margin-top:14px">';
  if(!mine.length)h+='<div class="empty"><b>Nothing submitted yet</b><span>Send your completed assignment as a PDF or JSON file. A manager will see it.</span><button class="btn pri" data-act="subnew">'+ICON.plus+"Submit file</button></div>";
  else h+='<div class="list">'+mine.map(function(x){return subRow(x,false)}).join("")+"</div>";
  return h+"</div>";
}
function filteredSubs(){
  return S.subs.filter(function(x){return (S.sfilter==="All"||x.status===S.sfilter.toLowerCase())&&(S.smem==="All"||x.by===S.smem)}).sort(function(a,b){return (b.createdAt||"").localeCompare(a.createdAt||"")});
}
function vFiles(){
  var all=S.subs,list=filteredSubs();
  var h='<div class="row-h"><h2>Assignments</h2>'+(all.length?'<button class="btn sm" data-act="csvs">'+ICON.down+"List (CSV)</button>":"")+"</div>";
  if(!S.loaded.s)return h+loading();
  var by={};all.forEach(function(x){by[x.by]=1});
  var mem=Object.keys(by).map(function(id){return {id:id,name:memberName(id)}}).sort(function(a,b){return a.name.localeCompare(b.name)});
  h+='<div class="sec" style="margin-top:14px"><div class="controls"><select class="select" id="sf" aria-label="Status">'+["All","New","Reviewed"].map(function(o){return "<option"+(o===S.sfilter?" selected":"")+">"+o+"</option>"}).join("")+'</select><select class="select" id="sm" aria-label="Staff member"><option value="All">All staff</option>'+mem.map(function(m){return '<option value="'+esc(m.id)+'"'+(m.id===S.smem?" selected":"")+">"+esc(m.name)+"</option>"}).join("")+"</select></div>";
  if(!all.length)h+='<div class="empty"><b>No files yet</b><span>PDF and JSON files that staff submit appear here. You can read, download and export them.</span></div>';
  else if(!list.length)h+='<div class="empty"><b>No matches</b><span>Change the filters above.</span></div>';
  else h+='<span class="wno">'+list.length+(list.length===1?" file":" files")+'</span><div class="list">'+list.map(function(x){return subRow(x,true)}).join("")+"</div>";
  return h+"</div>";
}
function openSubmit(){
  var h='<form id="sform" novalidate><fieldset>'+fld("Title","title","text","",{req:1,ph:"e.g. Site inspection, week 40"})+
    '<div class="fld"><label for="f_note">Note (optional)</label><textarea class="textarea" id="f_note" name="note" maxlength="2000" placeholder="Anything the manager should know"></textarea></div>'+
    '<div class="fld"><label for="f_file">File (PDF or JSON, up to 10 MB) <span class="req">*</span></label><input class="input" id="f_file" name="file" type="file" accept=".pdf,.json,application/pdf,application/json" required></div></fieldset>'+
    '<div class="acts" style="margin-top:22px"><button class="btn pri" type="submit">Submit</button><button class="btn" type="button" data-act="close">Cancel</button></div></form>';
  openSheet("Submit assignment",h);S.sheet={t:"snew"};
}
function safeName(n){
  var m=/\.([A-Za-z0-9]+)$/.exec(n),ext=m?m[1].toLowerCase():"";
  var base=n.replace(/\.[A-Za-z0-9]+$/,"").replace(/[^A-Za-z0-9._-]+/g,"_").replace(/^_+|_+$/g,"").slice(0,60)||"file";
  return base+"."+ext;
}
async function saveSubmission(f){
  var o=formData(f),fi=f.querySelector('input[type="file"]'),file=fi&&fi.files&&fi.files[0];
  if(!o.title){toast("Enter a title.");document.getElementById("f_title").focus();return}
  if(!file){toast("Choose a PDF or JSON file.");return}
  var ext=((/\.([A-Za-z0-9]+)$/.exec(file.name)||[])[1]||"").toLowerCase();
  if(ext!=="pdf"&&ext!=="json"){toast("Only PDF and JSON files are accepted.");return}
  if(file.size<=0){toast("That file is empty.");return}
  if(file.size>MAXFILE){toast("The file is larger than 10 MB.");return}
  try{
    if(ext==="pdf"){var head=await file.slice(0,5).text();if(head.indexOf("%PDF")!==0){toast("This does not look like a valid PDF.");return}}
    else{JSON.parse(await file.text())}
  }catch(e){toast(ext==="json"?"This JSON file is not valid. Fix it and try again.":"Could not read that file.");return}
  var btn=f.querySelector('[type="submit"]');btn.disabled=true;btn.textContent="Uploading…";
  var path=S.me.id+"/"+Date.now()+"-"+safeName(file.name);
  var up=await sb.storage.from(BUCKET).upload(path,file,{contentType:ext==="pdf"?"application/pdf":"application/json",upsert:false});
  if(up.error){console.error(up.error);toast(/row-level|policy|permission/i.test(up.error.message||"")?"You do not have permission to upload.":"Upload failed. Check your connection and try again.");btn.disabled=false;btn.textContent="Submit";return}
  var ins=await sb.from("hk_submissions").insert({title:o.title,note:nz(o.note),file_path:path,file_name:file.name.slice(0,255),file_type:ext,file_size:file.size});
  if(ins.error){await sb.storage.from(BUCKET).remove([path]);toast(dbErr(ins.error));btn.disabled=false;btn.textContent="Submit";return}
  closeSheet();toast("Submitted.");await loadAll();render();
}
function openSub(id){
  var x=byId(S.subs,id);if(!x)return;
  var mgr=isMgr();S.sheet={t:"sub",id:id};
  var rows=[["Title",x.title],["Note",x.note]];
  if(mgr)rows.push(["From",memberName(x.by)]);
  rows.push(["Submitted",ldate(x.createdAt)],["File",x.fileName,1],["Type / size",x.type.toUpperCase()+" · "+fsize(x.size)],["Status",x.status==="reviewed"?"Reviewed":(mgr?"New":"Sent, waiting for a manager")]);
  if(x.status==="reviewed"){rows.push(["Reviewed by",x.reviewedBy?memberName(x.reviewedBy):""],["Reviewed",ldate(x.reviewedAt)]);if(x.reviewNote)rows.push(["Review note",x.reviewNote])}
  var h=kv(rows)+'<div class="acts"><button class="btn pri" data-act="dls" data-id="'+esc(id)+'">'+ICON.down+"Download file</button>"+(x.type==="json"?'<button class="btn" data-act="viewj" data-id="'+esc(id)+'">View contents</button>':"")+"</div>";
  h+='<div id="jbox"></div>';
  if(mgr){
    if(x.status==="new")h+='<form id="revform" data-id="'+esc(id)+'" novalidate><fieldset><legend>Review</legend><div class="fld"><label for="f_rnote">Note (optional)</label><textarea class="textarea" id="f_rnote" name="rnote" maxlength="1000" placeholder="e.g. Checked, thank you"></textarea></div><button class="btn pri" type="submit">Mark as reviewed</button></fieldset></form>';
    else h+='<div class="acts"><button class="btn" data-act="unrev" data-id="'+esc(id)+'">Mark as new again</button></div>';
  }
  if(mgr||x.status==="new")h+='<div class="acts"><button class="btn bad" data-act="dels" data-id="'+esc(id)+'">'+(S.confirm?"Tap again to delete":"Delete")+"</button></div>";
  openSheet(x.title,h);S.sheet={t:"sub",id:id};
}
async function fetchSub(x){var r=await sb.storage.from(BUCKET).download(x.path);if(r.error)throw r.error;return r.data}
async function downloadSub(id){
  var x=byId(S.subs,id);if(!x)return;
  if(!S.dl){toast("Downloading is not available in this view.");return}
  try{var b=await fetchSub(x);await S.dl.save({filename:x.fileName,data:b})}
  catch(e){if(e&&e.code==="declined")return;console.error(e);toast("Could not download the file.")}
}
var jcache={};
async function loadJson(x){
  if(jcache[x.id])return jcache[x.id];
  var b=await fetchSub(x),t=await b.text(),v=JSON.parse(t);
  return (jcache[x.id]={text:JSON.stringify(v,null,2),value:v});
}
function jsonRows(v){
  if(v&&!Array.isArray(v)&&typeof v==="object"){var ks=Object.keys(v);if(ks.length===1&&Array.isArray(v[ks[0]]))v=v[ks[0]]}
  if(!Array.isArray(v)||!v.length)return null;
  if(!v.every(function(r){return r&&typeof r==="object"&&!Array.isArray(r)}))return null;
  var cols=[];v.forEach(function(r){Object.keys(r).forEach(function(k){if(cols.indexOf(k)<0)cols.push(k)})});
  return {cols:cols,rows:v.map(function(r){return cols.map(function(c){var q=r[c];return q==null?"":typeof q==="object"?JSON.stringify(q):q})})};
}
async function viewJson(id){
  var x=byId(S.subs,id),box=document.getElementById("jbox");if(!x||!box)return;
  box.innerHTML='<div class="skel"></div>';
  try{
    var j=await loadJson(x);
    var tbl=jsonRows(j.value);
    var big=j.text.length>200000;
    box.innerHTML='<div class="stack" style="margin-top:14px"><pre class="pre">'+esc(big?j.text.slice(0,200000)+"\n… (shortened, download the file for everything)":j.text)+'</pre><div class="acts"><button class="btn" data-act="copyj" data-id="'+esc(id)+'">Copy</button>'+(tbl?'<button class="btn" data-act="csvj" data-id="'+esc(id)+'">'+ICON.down+"Export as CSV</button>":"")+"</div></div>";
  }catch(e){console.error(e);box.innerHTML='<p class="note">Could not read this file as JSON.</p>'}
}
async function csvJson(id){
  var x=byId(S.subs,id);if(!x)return;
  try{var j=await loadJson(x),t=jsonRows(j.value);if(!t){toast("This JSON is not a list of records.");return}
    exportCsv(x.fileName.replace(/\.json$/i,"")+".csv",t.cols,t.rows)}
  catch(e){toast("Could not export this file.")}
}
function exportSubs(){
  exportCsv("hawkeye-assignments-"+today()+".csv",["Submitted","From","Title","Note","File","Type","Size (KB)","Status","Reviewed by","Reviewed","Review note"],
    filteredSubs().map(function(x){return [x.createdAt,memberName(x.by),x.title,x.note,x.fileName,x.type,Math.round(x.size/1024),x.status,x.reviewedBy?memberName(x.reviewedBy):"",x.reviewedAt,x.reviewNote]}));
}
async function setReview(id,status,note){
  var res=await sb.from("hk_submissions").update({status:status,review_note:status==="reviewed"?nz(note):null}).eq("id",id);
  if(res.error){toast(dbErr(res.error));return false}
  await loadAll();render();return true;
}
async function deleteSub(id){
  var x=byId(S.subs,id);if(!x)return;
  var r=await sb.storage.from(BUCKET).remove([x.path]);
  if(r.error){toast(dbErr(r.error));return}
  var d=await sb.from("hk_submissions").delete().eq("id",id);
  if(d.error){toast(dbErr(d.error));return}
  delete jcache[id];closeSheet();toast("Deleted.");await loadAll();render();
}

/* ---------- salaries ---------- */
function salLabel(m){return "Salary - "+mlabel(m)}
function salPaid(w,m){var d=salLabel(m);return S.allExp.some(function(e){return e.category==="Salary"&&e.workerId===w.id&&e.description===d})}
function dueList(m){return S.workers.filter(function(w){return w.status==="Active"&&w.pay>0&&!salPaid(w,m)}).sort(function(a,b){return (a.name||"").localeCompare(b.name||"")})}
function vRecord(){
  return '<div class="acts" style="margin-top:14px"><button class="btn pri" data-act="addexp">'+ICON.plus+'Add expense</button><button class="btn pri" data-act="paysal">'+ICON.plus+"Pay salary</button></div>";
}
function vDue(){
  if(!S.loaded.w||!S.workers.length)return "";
  var m=thisMonth(),d=dueList(m);
  var h='<div class="sec" style="margin-top:20px"><h3>Salaries due · '+esc(mlabel(m))+"</h3>";
  if(!d.length)return h+'<span class="note">Every active worker with a monthly pay has been paid for '+esc(mlabel(m))+".</span></div>";
  h+='<div class="list">'+d.slice(0,40).map(function(w){
    return '<div class="item" style="cursor:default"><span class="av">'+esc(initials(w.name))+'</span><span class="grow"><span class="t1" style="display:block">'+esc(w.name)+'</span><span class="t2" style="display:block">'+esc(fmt(w.pay)+(w.payMethod?" · "+w.payMethod:""))+'</span></span><button class="btn pri sm" data-act="paysal" data-id="'+esc(w.id)+'">Pay</button></div>';
  }).join("")+"</div>";
  if(d.length>40)h+='<span class="note">Showing 40 of '+d.length+".</span>";
  return h+"</div>";
}
function openPaySalary(wid){
  if(!isMgr())return;
  var ws=S.workers.filter(function(w){return w.status!=="Exited"||w.id===wid}).sort(function(a,b){return (a.name||"").localeCompare(b.name||"")});
  var w=wid?byId(S.workers,wid):null;
  var h='<form id="salform" novalidate><fieldset>'+
    '<div class="fld"><label for="f_sw">Worker <span class="req">*</span></label><select class="select" id="f_sw" name="sw"><option value="">Choose a worker</option>'+ws.map(function(x){return '<option value="'+esc(x.id)+'"'+(x.id===wid?" selected":"")+">"+esc(x.name+(x.workerNo?" ("+x.workerNo+")":""))+"</option>"}).join("")+"</select></div>"+
    '<div class="grid2"><div class="fld"><label for="f_sm">Salary for</label><input class="input" id="f_sm" name="sm" type="month" value="'+thisMonth()+'"></div>'+fld("Date paid","date","date",today(),{req:1})+"</div>"+
    fld("Amount (KES)","amount","number",w&&w.pay?w.pay:"",{req:1,mode:"decimal"})+
    '<div class="grid2">'+sel("Paid by","method",METHODS,(w&&w.payMethod&&METHODS.indexOf(w.payMethod)>=0)?w.payMethod:"M-PESA")+fld("Reference (M-PESA code)","ref","text","")+"</div></fieldset>"+
    '<p class="note" id="saldup" style="margin:10px 0 0"></p>'+
    '<div class="acts" style="margin-top:18px"><button class="btn pri" type="submit">Record salary</button><button class="btn" type="button" data-act="close">Cancel</button></div></form>';
  openSheet("Pay salary",h);S.sheet={t:"sal"};
  salNote();
}
function salNote(){
  var f=document.getElementById("salform");if(!f)return;
  var w=byId(S.workers,f.elements.sw.value),m=f.elements.sm.value,n=document.getElementById("saldup");
  n.textContent=(w&&/^\d{4}-\d{2}$/.test(m)&&salPaid(w,m))?w.name+" already has a salary recorded for "+mlabel(m)+". Saving will add another payment.":"";
}
async function saveSalary(f){
  var o=formData(f),w=byId(S.workers,o.sw),amt=Number(o.amount);
  if(!w){toast("Choose a worker.");return}
  if(!/^\d{4}-\d{2}$/.test(o.sm||"")){toast("Choose the month this salary is for.");return}
  if(!o.date){toast("Choose the date paid.");return}
  if(!(amt>0)){toast("Enter an amount greater than zero.");document.getElementById("f_amount").focus();return}
  if(salPaid(w,o.sm)&&!f.dataset.ok){f.dataset.ok="1";toast("Already paid for "+mlabel(o.sm)+". Tap Record salary again to add another payment.");return}
  var btn=f.querySelector('[type="submit"]');btn.disabled=true;
  var back=S.sheet&&S.sheet.from;
  var res=await sb.from("hk_expenses").insert({expense_date:o.date,amount:amt,category:"Salary",description:salLabel(o.sm),worker_id:w.id,method:nz(o.method),ref:nz(o.ref),status:"approved"});
  if(res.error){toast(dbErr(res.error));btn.disabled=false;return}
  closeSheet();toast("Salary recorded for "+w.name+".");
  await loadAll();render();
  if(back)openWorker(back);
}

/* ---------- events ---------- */
document.addEventListener("click",function(ev){
  var t=ev.target.closest("[data-act]");if(!t)return;
  var a=t.dataset.act,id=t.dataset.id;
  if(a==="veil"){if(ev.target===t)closeSheet();return}
  if(a==="close"){closeSheet();return}
  if(a==="tab"){closeSheet();S.tab=t.dataset.v;render();window.scrollTo(0,0);return}
  if(a==="stab"){S.stab=t.dataset.v;render();window.scrollTo(0,0);return}
  if(a==="subnew"){openSubmit();return}
  if(a==="opens"){openSub(id);return}
  if(a==="dls"){downloadSub(id);return}
  if(a==="viewj"){viewJson(id);return}
  if(a==="csvj"){csvJson(id);return}
  if(a==="csvs"){exportSubs();return}
  if(a==="copyj"){var xj=byId(S.subs,id);var cj=xj&&jcache[xj.id];if(!cj)return;(navigator.clipboard?navigator.clipboard.writeText(cj.text):Promise.reject()).then(function(){toast("Copied.")}).catch(function(){toast("Copy did not work. Select the text and copy it.")});return}
  if(a==="unrev"){setReview(id,"new").then(function(ok){if(ok){toast("Marked as new.");openSub(id)}});return}
  if(a==="dels"){
    if(!S.confirm){S.confirm=true;t.textContent="Tap again to delete";return}
    deleteSub(id);return;
  }
  if(a==="enroll"){openEnroll();return}
  if(a==="addexp"){var from=t.dataset.w;var keep=from&&S.sheet&&S.sheet.t==="w";openExpense(null,from);if(keep)S.sheet.from=from;return}
  if(a==="openw"){openWorker(id);return}
  if(a==="editw"){openEnroll(byId(S.workers,id));return}
  if(a==="opene"){var e=byId(S.allExp,id);if(!e)return;if(isMgr()||e.status==="pending")openExpense(e);else openExpenseView(e);return}
  if(a==="viewe"){var e2=byId(S.allExp,id);if(e2)openExpenseView(e2);return}
  if(a==="edite"){var e3=byId(S.allExp,id);if(e3)openExpense(e3);return}
  if(a==="delw"){
    if(!S.confirm){S.confirm=true;t.textContent="Tap again to delete";return}
    sb.from("hk_workers").delete().eq("id",id).then(function(r){if(r.error){toast(dbErr(r.error));return}closeSheet();toast("Worker deleted.");refresh()});return;
  }
  if(a==="dele"){
    if(!S.confirm){S.confirm=true;t.textContent="Tap again to delete";return}
    sb.from("hk_expenses").delete().eq("id",id).then(function(r){if(r.error){toast(dbErr(r.error));return}closeSheet();toast("Expense deleted.");refresh()});return;
  }
  if(a==="paysal"){var fromW=S.sheet&&S.sheet.t==="w";openPaySalary(id);if(fromW&&S.sheet)S.sheet.from=id;return}
  if(a==="catfilter"){S.ecat=t.dataset.c;S.emonth=S.amonth||thisMonth();S.tab="expenses";render();window.scrollTo(0,0);return}
  if(a==="appr"){decide([id],"approved").then(function(ok){if(ok){closeSheet();toast("Approved.")}});return}
  if(a==="apprall"){var ids=pendingList().map(function(x){return x.id});if(ids.length)decide(ids,"approved").then(function(ok){if(ok)toast(ids.length+" approved.")});return}
  if(a==="rej"){openReject(id);return}
  if(a==="account"){openAccount();return}
  if(a==="team"){openTeam();return}
  if(a==="addmem"){openAddMember();return}
  if(a==="member"){openMember(id);return}
  if(a==="genpw"){document.getElementById("f_pw").value=genPw();return}
  if(a==="genrpw"){document.getElementById("f_rpw").value=genPw();return}
  if(a==="toggleactive"){var m=byId(S.members,id);if(!m)return;sb.from("hk_members").update({active:!m.active}).eq("user_id",id).then(function(r){if(r.error){toast(dbErr(r.error));return}toast(m.active?"Deactivated.":"Activated.");loadAll().then(function(){render();openMember(id)})});return}
  if(a==="copycreds"){var txt=t.dataset.v;(navigator.clipboard?navigator.clipboard.writeText(txt):Promise.reject()).then(function(){toast("Copied.")}).catch(function(){toast("Copy did not work. Select the text and copy it.")});return}
  if(a==="authmode"){S.authMode=t.dataset.v;renderAuth();return}
  if(a==="signout"){signOut();return}
  if(a==="pdf"){downloadReport(t.dataset.r);return}
  if(a==="pdfe"){downloadExpensesView();return}
  if(a==="pdfw"){downloadRegister();return}
  if(a==="expw"){exportWorkers();return}
  if(a==="expe"){exportExpenses();return}
});
document.addEventListener("submit",async function(ev){
  ev.preventDefault();
  var f=ev.target,btn=f.querySelector('[type="submit"]');
  if(f.id==="wform")saveWorker(f);
  else if(f.id==="eform")saveExpense(f);
  else if(f.id==="sform")saveSubmission(f);
  else if(f.id==="salform")saveSalary(f);
  else if(f.id==="revform"){btn.disabled=true;var rid=f.dataset.id;var okr=await setReview(rid,"reviewed",formData(f).rnote);if(okr){toast("Marked as reviewed.");openSub(rid)}else btn.disabled=false}
  else if(f.id==="fsignin"){
    var o=formData(f);if(!o.email||!o.password){authMsg("Enter your email and password.");return}
    btn.disabled=true;authMsg("");var ok=await doSignIn(o.email,o.password);if(!ok&&btn)btn.disabled=false;
  }
  else if(f.id==="fsetup"){
    var s=formData(f);btn.disabled=true;authMsg("");
    var r=await callFn({action:"setup",code:s.code,full_name:s.full_name,email:s.email,password:s.password});
    if(r.error){authMsg(r.error);btn.disabled=false;return}
    S.setupDone=true;var ok2=await doSignIn(s.email,s.password);if(!ok2){S.authMode="in";renderAuth()}
  }
  else if(f.id==="rejform"){
    btn.disabled=true;var n=formData(f).note;var ok3=await decide([f.dataset.id],"rejected",n);
    if(ok3){closeSheet();toast("Rejected.")}else btn.disabled=false;
  }
  else if(f.id==="pwform"){
    var p=formData(f).npw;if(!p||p.length<8){toast("Use at least 8 characters.");return}
    btn.disabled=true;var r2=await sb.auth.updateUser({password:p});btn.disabled=false;
    if(r2.error){toast("Could not change the password. Try again.");return}
    f.reset();toast("Password changed.");
  }
  else if(f.id==="addmem"){
    var m=formData(f);btn.disabled=true;
    var r3=await callFn({action:"create_user",full_name:m.fn,email:m.em,role:m.role,password:m.pw});
    if(r3.error){toast(r3.error);btn.disabled=false;return}
    await loadAll();render();showCreds(m.fn,m.em.trim().toLowerCase(),m.pw,"Account created");
  }
  else if(f.id==="rolform"){
    btn.disabled=true;var id2=f.dataset.id;var r4=await sb.from("hk_members").update({role:formData(f).role}).eq("user_id",id2);btn.disabled=false;
    if(r4.error){toast(dbErr(r4.error));return}
    toast("Role saved.");await loadAll();render();openMember(id2);
  }
  else if(f.id==="resetform"){
    var pw=formData(f).pw;btn.disabled=true;var mm=byId(S.members,f.dataset.id);
    var r5=await callFn({action:"set_password",user_id:f.dataset.id,password:pw});btn.disabled=false;
    if(r5.error){toast(r5.error);return}
    showCreds(mm.name,mm.email,pw,"Password reset");
  }
});
document.addEventListener("input",function(ev){if(ev.target.id==="q"){S.q=ev.target.value;render()}});
document.addEventListener("change",function(ev){
  var i=ev.target.id;
  if(i==="wst"){S.wstatus=ev.target.value;render()}
  if(i==="em"){S.emonth=ev.target.value;render()}
  if(i==="ec"){S.ecat=ev.target.value;render()}
  if(i==="am"){S.amonth=ev.target.value;render()}
  if(i==="f_sw"||i==="f_sm"){
    var sf=document.getElementById("salform");
    if(sf){sf.dataset.ok="";
      if(i==="f_sw"){var sw=byId(S.workers,ev.target.value);if(sw){sf.elements.amount.value=sw.pay||"";if(sw.payMethod&&METHODS.indexOf(sw.payMethod)>=0)sf.elements.method.value=sw.payMethod}}
      salNote()}
  }
  if(i==="sf"){S.sfilter=ev.target.value;render()}
  if(i==="sm"){S.smem=ev.target.value;render()}
});
document.addEventListener("keydown",function(ev){if(ev.key==="Escape"&&document.querySelector(".veil"))closeSheet()});

/* ---------- start ---------- */
(async function(){
  if(!window.supabase||!window.supabase.createClient){document.getElementById("auth").hidden=false;document.getElementById("authbody").innerHTML='<div class="auth-box"><b>Could not load</b><span class="note">Check your internet connection and reload the page.</span></div>';return}
  sb=window.supabase.createClient(SB_URL,SB_KEY,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:false}});
  sb.auth.onAuthStateChange(function(evn){if(evn==="SIGNED_OUT"&&S.me){S.me=null;showAuth("in")}});
  var s=await sb.auth.getSession();
  if(s.data&&s.data.session){await boot()}else{showAuth("in")}
  try{var st=await callFn({action:"status"});if(typeof st.setup_done==="boolean"){S.setupDone=st.setup_done;if(!S.me&&S.authMode==="in")renderAuth()}}catch(e){}
})();
})();
</script>
</body>
</html>

function kv(rows){
  return '<dl class="kv">'+rows.map(function(r){return "<div><dt>"+r[0]+'</dt><dd'+(r[2]?' class="mono"':"")+">"+(r[1]?esc(r[1]):"—")+"</dd></div>"}).join("")+"</dl>";

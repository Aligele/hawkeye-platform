  }
  h+='<form id="resetform" data-id="'+esc(m.id)+'" novalidate><fieldset><legend>Reset password</legend><div class="fld"><label for="f_rpw">New password</label><div style="display:flex;gap:8px"><input class="input" id="f_rpw" name="pw" type="text" autocomplete="off" value="'+esc(genPw())+'"><button class="btn" type="button" data-act="genrpw">New</button></div></div><button class="btn" type="submit">Set this password</button></fieldset></form>';

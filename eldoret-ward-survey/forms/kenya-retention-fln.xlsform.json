{
  "survey": [
    {
      "type": "start",
      "name": "start"
    },
    {
      "type": "end",
      "name": "end"
    },
    {
      "type": "today",
      "name": "today"
    },
    {
      "type": "deviceid",
      "name": "deviceid"
    },
    {
      "type": "text",
      "name": "enumerator_id",
      "label": "Enumerator ID",
      "required": "yes"
    },
    {
      "type": "geopoint",
      "name": "gps",
      "label": "GPS location (only if respondent consented)",
      "hint": "Skip if no consent to record location"
    },
    {
      "type": "select_one respondent_type",
      "name": "respondent_type",
      "label": "Who is being interviewed?",
      "required": "yes"
    },
    {
      "type": "begin_group",
      "name": "grp_consent",
      "label": "A. Consent and location"
    },
    {
      "type": "note",
      "name": "consent_text",
      "label": "Hawkeye Africa is collecting information on children's schooling and learning. Participation is voluntary, answers are confidential and will be reported only in aggregate. You may skip any question or stop at any time. Do you agree to take part?"
    },
    {
      "type": "select_one yes_no",
      "name": "consent",
      "label": "Respondent consents to the interview",
      "required": "yes"
    },
    {
      "type": "note",
      "name": "no_consent_note",
      "label": "No consent. Stop the interview and thank the respondent.",
      "relevant": "${consent}='no'"
    },
    {
      "type": "select_one yes_no",
      "name": "gps_consent",
      "label": "Consent to record GPS location?",
      "required": "yes",
      "relevant": "${consent}='yes'"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "grp_loc",
      "label": "Location",
      "relevant": "${consent}='yes'"
    },
    {
      "type": "select_one county",
      "name": "county",
      "label": "County",
      "required": "yes",
      "appearance": "minimal"
    },
    {
      "type": "text",
      "name": "sub_county",
      "label": "Sub-county",
      "required": "yes"
    },
    {
      "type": "text",
      "name": "ward",
      "label": "Ward",
      "required": "yes"
    },
    {
      "type": "select_one setting",
      "name": "setting",
      "label": "Setting",
      "required": "yes"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "grp_cg",
      "label": "Caregiver / household",
      "relevant": "${consent}='yes' and ${respondent_type}='caregiver'"
    },
    {
      "type": "select_one relationship",
      "name": "relationship",
      "label": "Respondent's relationship to the children",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "hh_size",
      "label": "Number of people living in the household",
      "required": "yes",
      "constraint": ". >= 1 and . <= 40",
      "constraint_message": "Enter 1-40"
    },
    {
      "type": "select_one sex",
      "name": "head_sex",
      "label": "Sex of household head",
      "required": "yes"
    },
    {
      "type": "select_one head_edu",
      "name": "head_edu",
      "label": "Highest education of household head",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "dist_school",
      "label": "Walking time to nearest school (minutes)",
      "hint": "Enter 999 if unknown",
      "required": "yes",
      "constraint": ". >= 0 and . <= 999",
      "constraint_message": "0-999"
    },
    {
      "type": "select_one yes_no_dk",
      "name": "fees_missed",
      "label": "In the past 12 months, did the household miss paying school fees or costs for any child?",
      "required": "yes"
    },
    {
      "type": "select_one yes_no_dk",
      "name": "child_working",
      "label": "Is any child aged 17 or under in the household doing paid or regular work?",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "child_count",
      "label": "How many children aged 4-17 live in this household?",
      "required": "yes",
      "constraint": ". >= 0 and . <= 15",
      "constraint_message": "0-15"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_repeat",
      "name": "child",
      "label": "Child roster (one entry per child aged 4-17)",
      "relevant": "${consent}='yes' and ${respondent_type}='caregiver' and ${child_count} > 0",
      "repeat_count": "${child_count}"
    },
    {
      "type": "calculate",
      "name": "child_no",
      "calculation": "position(..)"
    },
    {
      "type": "note",
      "name": "child_hdr",
      "label": "Child number ${child_no}"
    },
    {
      "type": "begin_group",
      "name": "grp_prof",
      "label": "B. Child profile"
    },
    {
      "type": "text",
      "name": "child_name",
      "label": "Child's first name or code (not stored in reports)",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "child_age",
      "label": "Age in completed years",
      "required": "yes",
      "constraint": ". >= 4 and . <= 17",
      "constraint_message": "Age must be 4-17"
    },
    {
      "type": "select_one sex",
      "name": "child_sex",
      "label": "Sex",
      "required": "yes"
    },
    {
      "type": "select_one refugee",
      "name": "refugee_status",
      "label": "Refugee or host community status",
      "required": "yes"
    },
    {
      "type": "note",
      "name": "wg_intro",
      "label": "Washington Group Short Set: Do you (does the child) have difficulty...?"
    },
    {
      "type": "select_one wg",
      "name": "wg_see",
      "label": "Difficulty seeing, even if wearing glasses?",
      "required": "yes"
    },
    {
      "type": "select_one wg",
      "name": "wg_hear",
      "label": "Difficulty hearing, even if using a hearing aid?",
      "required": "yes"
    },
    {
      "type": "select_one wg",
      "name": "wg_walk",
      "label": "Difficulty walking or climbing steps?",
      "required": "yes"
    },
    {
      "type": "select_one wg",
      "name": "wg_remember",
      "label": "Difficulty remembering or concentrating?",
      "required": "yes"
    },
    {
      "type": "select_one wg",
      "name": "wg_self",
      "label": "Difficulty with self-care such as washing or dressing?",
      "required": "yes"
    },
    {
      "type": "select_one wg",
      "name": "wg_comm",
      "label": "Difficulty communicating, for example understanding or being understood?",
      "required": "yes"
    },
    {
      "type": "calculate",
      "name": "special_need",
      "calculation": "if(${wg_see}='a_lot' or ${wg_see}='cannot' or ${wg_hear}='a_lot' or ${wg_hear}='cannot' or ${wg_walk}='a_lot' or ${wg_walk}='cannot' or ${wg_remember}='a_lot' or ${wg_remember}='cannot' or ${wg_self}='a_lot' or ${wg_self}='cannot' or ${wg_comm}='a_lot' or ${wg_comm}='cannot',1,0)"
    },
    {
      "type": "select_one yes_no_dk",
      "name": "birth_reg",
      "label": "Does the child have a birth certificate or birth notification?",
      "required": "yes"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "grp_ret",
      "label": "C. Enrolment and retention"
    },
    {
      "type": "select_one yes_no_dk",
      "name": "ever_attended",
      "label": "Has the child ever attended school or ECDE?",
      "required": "yes"
    },
    {
      "type": "select_one yes_no",
      "name": "in_school",
      "label": "Is the child in school or ECDE now?",
      "required": "yes",
      "relevant": "${ever_attended}='yes'"
    },
    {
      "type": "select_one grade",
      "name": "current_grade",
      "label": "Current grade",
      "required": "yes",
      "relevant": "${in_school}='yes'"
    },
    {
      "type": "select_one school_type",
      "name": "school_type",
      "label": "School type",
      "required": "yes",
      "relevant": "${in_school}='yes'"
    },
    {
      "type": "select_one grade",
      "name": "last_grade",
      "label": "Last grade completed",
      "required": "yes",
      "relevant": "${ever_attended}='yes' and ${in_school}='no'"
    },
    {
      "type": "integer",
      "name": "year_left",
      "label": "Year the child left school",
      "required": "yes",
      "relevant": "${ever_attended}='yes' and ${in_school}='no'",
      "constraint": ". >= 2005 and . <= 2026",
      "constraint_message": "2005-2026"
    },
    {
      "type": "integer",
      "name": "age_left",
      "label": "Age when the child left",
      "required": "yes",
      "relevant": "${ever_attended}='yes' and ${in_school}='no'",
      "constraint": ". >= 3 and . <= ${child_age}",
      "constraint_message": "Cannot exceed current age"
    },
    {
      "type": "select_one leave_reason",
      "name": "leave_reason",
      "label": "Main reason the child left school",
      "required": "yes",
      "relevant": "${ever_attended}='yes' and ${in_school}='no'"
    },
    {
      "type": "text",
      "name": "leave_reason_other",
      "label": "Specify other reason",
      "required": "yes",
      "relevant": "${leave_reason}='other'"
    },
    {
      "type": "select_one transition",
      "name": "leave_transition",
      "label": "Did the child leave at one of these transitions?",
      "required": "yes",
      "relevant": "${ever_attended}='yes' and ${in_school}='no'"
    },
    {
      "type": "select_one repeat_times",
      "name": "repeated",
      "label": "How many times has the child repeated a grade?",
      "required": "yes",
      "relevant": "${ever_attended}='yes'"
    },
    {
      "type": "select_one yes_no_dk",
      "name": "would_return",
      "label": "Would the child return to school if support were available?",
      "required": "yes",
      "relevant": "${ever_attended}!='dk' and ${in_school}!='yes'"
    },
    {
      "type": "select_multiple support",
      "name": "return_support",
      "label": "What support would be needed?",
      "required": "yes",
      "relevant": "${would_return}='yes'"
    },
    {
      "type": "select_multiple decider",
      "name": "decision_maker",
      "label": "Who decides whether the child goes to school?",
      "required": "yes"
    },
    {
      "type": "end_group"
    },
    {
      "type": "begin_group",
      "name": "grp_learn",
      "label": "D. Foundational learning (children aged 8-9)",
      "relevant": "${child_age} >= 8 and ${child_age} <= 9"
    },
    {
      "type": "select_one yes_no",
      "name": "child_assent",
      "label": "Caregiver agrees and child is willing to do a short reading and maths activity",
      "required": "yes"
    },
    {
      "type": "begin_group",
      "name": "grp_learn_items",
      "label": "Activity",
      "relevant": "${child_assent}='yes'"
    },
    {
      "type": "select_one test_lang",
      "name": "test_lang",
      "label": "Language used for the activity",
      "required": "yes"
    },
    {
      "type": "select_one read_level",
      "name": "read_level",
      "label": "Highest reading level reached (Grade 2 story card)",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "comp_correct",
      "label": "Comprehension questions answered correctly (0-2)",
      "required": "yes",
      "relevant": "${read_level}='story' or ${read_level}='paragraph'",
      "constraint": ". >= 0 and . <= 2",
      "constraint_message": "0-2"
    },
    {
      "type": "select_one yes_no",
      "name": "add_ok",
      "label": "Solved the addition item correctly",
      "required": "yes"
    },
    {
      "type": "select_one yes_no",
      "name": "sub_ok",
      "label": "Solved the subtraction item correctly",
      "required": "yes"
    },
    {
      "type": "select_one yes_no",
      "name": "num_ok",
      "label": "Recognised numbers up to 99",
      "required": "yes"
    },
    {
      "type": "end_group"
    },
    {
      "type": "end_group"
    },
    {
      "type": "end_repeat"
    },
    {
      "type": "begin_group",
      "name": "grp_sh",
      "label": "F. School head module",
      "relevant": "${consent}='yes' and ${respondent_type}='school_head'"
    },
    {
      "type": "text",
      "name": "school_name",
      "label": "School name",
      "required": "yes"
    },
    {
      "type": "select_one school_type",
      "name": "sh_school_type",
      "label": "School type",
      "required": "yes"
    },
    {
      "type": "note",
      "name": "sh_note",
      "label": "Enter -99 where the school does not know the figure. Never estimate."
    },
    {
      "type": "integer",
      "name": "sh_rows",
      "label": "How many year-and-grade rows will you record?",
      "required": "yes",
      "constraint": ". >= 1 and . <= 30",
      "constraint_message": "1-30"
    },
    {
      "type": "begin_repeat",
      "name": "sh_row",
      "label": "Enrolment and dropouts by year and grade",
      "repeat_count": "${sh_rows}"
    },
    {
      "type": "select_one sh_year",
      "name": "sh_year",
      "label": "Year",
      "required": "yes"
    },
    {
      "type": "select_one grade",
      "name": "sh_grade",
      "label": "Grade",
      "required": "yes"
    },
    {
      "type": "integer",
      "name": "enrol_boys",
      "label": "Boys enrolled",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "integer",
      "name": "enrol_girls",
      "label": "Girls enrolled",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "integer",
      "name": "drop_boys",
      "label": "Boys who dropped out",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "integer",
      "name": "drop_girls",
      "label": "Girls who dropped out",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "end_repeat"
    },
    {
      "type": "integer",
      "name": "sn_boys",
      "label": "Boys with special needs enrolled now",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "integer",
      "name": "sn_girls",
      "label": "Girls with special needs enrolled now",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "integer",
      "name": "ref_boys",
      "label": "Refugee boys enrolled now",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "integer",
      "name": "ref_girls",
      "label": "Refugee girls enrolled now",
      "required": "yes",
      "constraint": ". >= 0 or . = -99",
      "constraint_message": "Enter 0 or more, or -99 if unknown"
    },
    {
      "type": "end_group"
    },
    {
      "type": "text",
      "name": "comments",
      "label": "Enumerator comments"
    }
  ],
